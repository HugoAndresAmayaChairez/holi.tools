{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "pkg/**",
        "pkg-node/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

---
import PrivacyPage from "../../components/PrivacyPage.astro";
import { SUPPORTED_LANGS, type LanguageCode } from "@holi/configs/i18n";
export function getStaticPaths() { return SUPPORTED_LANGS.filter((lang) => lang !== "en").map((lang) => ({ params: { lang } })); }
const lang = Astro.params.lang as LanguageCode;
---
<PrivacyPage lang={lang} />

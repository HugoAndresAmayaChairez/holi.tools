---
import type { ImageCopy } from "../i18n/ui";

interface Props { copy: ImageCopy }
const { copy } = Astro.props;
const modeEntries = Object.entries(copy.modes) as [keyof typeof copy.modes, { label: string; description: string }][];
---

<section id="image-workspace" class="image-workspace" aria-label={copy.workspaceLabel} data-labels={JSON.stringify(copy)}>
  <div class="workspace-topbar">
    <div>
      <span class="local-dot" aria-hidden="true"></span>
      <strong>{copy.localBadge}</strong>
    </div>
    <p id="workspace-status" role="status">{copy.ready}</p>
  </div>

  <div id="image-dropzone" class="dropzone">
    <input id="image-input" type="file" accept="image/jpeg,image/png,image/webp" multiple hidden />
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4m0 0 4 4m-4-4L8 8M5 14v4a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4" /></svg>
    <div><strong>{copy.dropTitle}</strong><span>{copy.dropHelp}</span></div>
    <button type="button" id="choose-images">{copy.chooseImages}</button>
    <small>{copy.supported}</small>
  </div>

  <div class="workspace-grid">
    <aside class="file-queue" aria-label={copy.files}>
      <div class="panel-heading"><h2>{copy.files}</h2><button type="button" id="clear-images">{copy.clear}</button></div>
      <p id="queue-empty" class="empty-copy">{copy.emptyQueue}</p>
      <div id="queue-list" class="queue-list"></div>
    </aside>

    <div class="preview-panel">
      <div class="preview-heading">
        <span>{copy.original}</span><span>{copy.result}</span>
      </div>
      <div id="compare-stage" class="compare-stage is-empty">
        <p id="preview-empty">{copy.previewEmpty}</p>
        <img id="original-preview" alt="" />
        <div id="result-clip" class="result-clip"><img id="result-preview" alt="" /></div>
        <div id="compare-divider" class="compare-divider" aria-hidden="true"><span>↔</span></div>
        <input id="compare-range" class="compare-range" type="range" min="0" max="100" value="50" aria-label={`${copy.original} / ${copy.result}`} />
      </div>
      <div class="preview-meta">
        <span><b>{copy.sourceLabel}</b><output id="source-meta">—</output></span>
        <span><b>{copy.outputLabel}</b><output id="output-meta">—</output></span>
      </div>
    </div>

    <aside class="settings-panel">
      <div class="mode-tabs" role="tablist" aria-label={copy.workspaceLabel}>
        {modeEntries.map(([id, mode], index) => (
          <button type="button" role="tab" data-mode={id} aria-selected={index === 0 ? "true" : "false"} title={mode.description}>{mode.label}</button>
        ))}
      </div>

      <div class="setting-pane" data-pane="optimize">
        <label for="quality"><span>{copy.quality}</span><output id="quality-value">82%</output></label>
        <input id="quality" type="range" min="35" max="100" value="82" />
      </div>
      <div class="setting-pane" data-pane="resize" hidden>
        <div class="dimension-grid">
          <label for="image-width">{copy.width}<input id="image-width" type="number" min="1" max="16384" value="1" /></label>
          <label for="image-height">{copy.height}<input id="image-height" type="number" min="1" max="16384" value="1" /></label>
        </div>
        <label class="check-row"><input id="lock-ratio" type="checkbox" checked /><span>{copy.lockRatio}</span></label>
      </div>
      <div class="setting-pane" data-pane="crop" hidden>
        <label for="crop-ratio">{copy.cropRatio}</label>
        <select id="crop-ratio"><option value="free">{copy.original}</option><option value="1:1">1:1</option><option value="4:5">4:5</option><option value="3:2">3:2</option><option value="16:9">16:9</option></select>
      </div>
      <div class="setting-pane" data-pane="convert" hidden>
        <label for="output-format">{copy.format}</label>
        <select id="output-format"><option value="original">{copy.originalFormat}</option><option value="image/jpeg">JPEG</option><option value="image/png">PNG</option><option value="image/webp">WebP</option></select>
      </div>
      <div class="setting-pane clean-pane" data-pane="clean" hidden><span aria-hidden="true">◇</span><p>{copy.cleanNote}</p></div>

      <div class="setting-summary">
        <span><b>{copy.format}</b><output id="format-summary">—</output></span>
        <span><b>{copy.quality}</b><output id="quality-summary">82%</output></span>
      </div>
      <div class="settings-actions">
        <button type="button" id="reset-settings" class="secondary-action">{copy.reset}</button>
        <button type="button" id="download-current" class="primary-action" disabled>{copy.downloadCurrent}</button>
        <button type="button" id="download-all" class="secondary-action" disabled>{copy.downloadAll}</button>
      </div>
    </aside>
  </div>
</section>

<script>
  import { zipSync } from "fflate";
  import { centeredCrop, exportName, fitSize, formatBytes, resolvedMime, type CropRatio, type OutputFormat } from "../lib/image-operations";

  type Item = { id: string; file: File; sourceUrl: string; width: number; height: number; outputUrl?: string; outputBlob?: Blob };
  type Labels = import("../i18n/ui").ImageCopy;
  const root = document.querySelector<HTMLElement>("#image-workspace");
  if (!root) throw new Error("Image workspace is missing");
  const labels = JSON.parse(root.dataset.labels || "{}") as Labels;
  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const input = byId<HTMLInputElement>("image-input");
  const dropzone = byId<HTMLElement>("image-dropzone");
  const queue = byId<HTMLElement>("queue-list");
  const queueEmpty = byId<HTMLElement>("queue-empty");
  const stage = byId<HTMLElement>("compare-stage");
  const originalPreview = byId<HTMLImageElement>("original-preview");
  const resultPreview = byId<HTMLImageElement>("result-preview");
  const resultClip = byId<HTMLElement>("result-clip");
  const divider = byId<HTMLElement>("compare-divider");
  const compareRange = byId<HTMLInputElement>("compare-range");
  const status = byId<HTMLElement>("workspace-status");
  const quality = byId<HTMLInputElement>("quality");
  const widthInput = byId<HTMLInputElement>("image-width");
  const heightInput = byId<HTMLInputElement>("image-height");
  const lockRatio = byId<HTMLInputElement>("lock-ratio");
  const cropRatio = byId<HTMLSelectElement>("crop-ratio");
  const outputFormat = byId<HTMLSelectElement>("output-format");
  const currentDownload = byId<HTMLButtonElement>("download-current");
  const allDownload = byId<HTMLButtonElement>("download-all");
  let items: Item[] = [];
  let activeId = "";
  let activeMode = "optimize";
  let timer = 0;
  let renderToken = 0;

  function activeItem() { return items.find((item) => item.id === activeId); }
  function setStatus(message: string) { status.textContent = message; }
  function mimeLabel(mime: string) { return mime.replace("image/", "").replace("jpeg", "JPEG").toUpperCase(); }
  function selectedMime(item: Item) { return resolvedMime(outputFormat.value as OutputFormat, item.file.type); }

  async function dimensions(url: string) {
    const image = new Image(); image.src = url;
    await image.decode();
    return { width: image.naturalWidth, height: image.naturalHeight };
  }

  async function addFiles(fileList: FileList | File[]) {
    const accepted = Array.from(fileList).filter((file) => ["image/jpeg", "image/png", "image/webp"].includes(file.type));
    for (const file of accepted) {
      const sourceUrl = URL.createObjectURL(file);
      try {
        const size = await dimensions(sourceUrl);
        items.push({ id: crypto.randomUUID(), file, sourceUrl, ...size });
      } catch { URL.revokeObjectURL(sourceUrl); }
    }
    if (!activeId && items[0]) selectItem(items[0].id, true);
    drawQueue();
    if (activeId) scheduleRender();
  }

  function selectItem(id: string, resetDimensions = false) {
    activeId = id;
    const item = activeItem(); if (!item) return;
    if (resetDimensions) { widthInput.value = String(item.width); heightInput.value = String(item.height); }
    originalPreview.src = item.sourceUrl;
    stage.classList.remove("is-empty");
    drawQueue();
    scheduleRender();
  }

  function removeItem(id: string) {
    const index = items.findIndex((item) => item.id === id); if (index < 0) return;
    const [removed] = items.splice(index, 1);
    URL.revokeObjectURL(removed.sourceUrl); if (removed.outputUrl) URL.revokeObjectURL(removed.outputUrl);
    if (activeId === id) { activeId = ""; const next = items[index] || items[index - 1]; if (next) selectItem(next.id, true); else clearPreview(); }
    drawQueue();
  }

  function clearPreview() {
    originalPreview.removeAttribute("src"); resultPreview.removeAttribute("src"); stage.classList.add("is-empty");
    byId<HTMLOutputElement>("source-meta").textContent = "—"; byId<HTMLOutputElement>("output-meta").textContent = "—";
    currentDownload.disabled = true; allDownload.disabled = true;
  }

  function drawQueue() {
    queue.replaceChildren(); queueEmpty.hidden = items.length > 0;
    for (const item of items) {
      const row = document.createElement("div"); row.className = `queue-item${item.id === activeId ? " is-active" : ""}`;
      const select = document.createElement("button"); select.type = "button"; select.className = "queue-select";
      const img = document.createElement("img"); img.src = item.sourceUrl; img.alt = "";
      const text = document.createElement("span"); const strong = document.createElement("strong"); strong.textContent = item.file.name;
      const small = document.createElement("small"); small.textContent = `${item.width}×${item.height} · ${formatBytes(item.file.size)}`;
      text.append(strong, small); select.append(img, text); select.addEventListener("click", () => selectItem(item.id, true));
      const remove = document.createElement("button"); remove.type = "button"; remove.className = "queue-remove"; remove.textContent = "×"; remove.setAttribute("aria-label", `${labels.clear}: ${item.file.name}`); remove.addEventListener("click", () => removeItem(item.id));
      row.append(select, remove); queue.append(row);
    }
  }

  async function encode(item: Item) {
    const image = new Image(); image.src = item.sourceUrl; await image.decode();
    const crop = centeredCrop(item.width, item.height, cropRatio.value as CropRatio);
    let size = fitSize(crop.sw, crop.sh, Number(widthInput.value), Number(heightInput.value), lockRatio.checked);
    if (activeMode === "crop") size = { width: crop.sw, height: crop.sh };
    const canvas = document.createElement("canvas"); canvas.width = size.width; canvas.height = size.height;
    const context = canvas.getContext("2d", { alpha: selectedMime(item) !== "image/jpeg" });
    if (!context) throw new Error("Canvas is unavailable");
    if (selectedMime(item) === "image/jpeg") { context.fillStyle = "#ffffff"; context.fillRect(0, 0, canvas.width, canvas.height); }
    context.imageSmoothingEnabled = true; context.imageSmoothingQuality = "high";
    context.drawImage(image, crop.sx, crop.sy, crop.sw, crop.sh, 0, 0, size.width, size.height);
    const mime = selectedMime(item);
    const blob = await new Promise<Blob>((resolve, reject) => canvas.toBlob((value) => value ? resolve(value) : reject(new Error("Encoding failed")), mime, Number(quality.value) / 100));
    return { blob, width: size.width, height: size.height, mime };
  }

  async function renderActive() {
    const item = activeItem(); if (!item) return;
    const token = ++renderToken; setStatus(labels.processing); currentDownload.disabled = true;
    try {
      const output = await encode(item); if (token !== renderToken) return;
      if (item.outputUrl) URL.revokeObjectURL(item.outputUrl);
      item.outputBlob = output.blob; item.outputUrl = URL.createObjectURL(output.blob); resultPreview.src = item.outputUrl;
      byId<HTMLOutputElement>("source-meta").textContent = `${item.width}×${item.height} · ${formatBytes(item.file.size)}`;
      byId<HTMLOutputElement>("output-meta").textContent = `${output.width}×${output.height} · ${formatBytes(output.blob.size)}`;
      byId<HTMLOutputElement>("format-summary").textContent = mimeLabel(output.mime);
      currentDownload.disabled = false; allDownload.disabled = items.length === 0; setStatus(labels.ready);
    } catch { if (token === renderToken) setStatus(labels.failed); }
  }

  function scheduleRender() { window.clearTimeout(timer); timer = window.setTimeout(renderActive, 120); }
  function syncQuality() { const value = `${quality.value}%`; byId<HTMLOutputElement>("quality-value").textContent = value; byId<HTMLOutputElement>("quality-summary").textContent = value; scheduleRender(); }

  async function download(item: Item) {
    const output = item.id === activeId && item.outputBlob ? { blob: item.outputBlob, mime: selectedMime(item) } : await encode(item);
    const link = document.createElement("a"); const url = URL.createObjectURL(output.blob);
    link.href = url; link.download = exportName(item.file.name, output.mime); link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000);
  }

  async function downloadZip() {
    if (!items.length) return; setStatus(labels.processing); allDownload.disabled = true;
    try {
      const entries: Record<string, Uint8Array> = {}; const usedNames = new Set<string>();
      for (const item of items) {
        const output = await encode(item); const baseName = exportName(item.file.name, output.mime); let name = baseName; let suffix = 2;
        while (usedNames.has(name)) { const dot = baseName.lastIndexOf("."); name = `${baseName.slice(0, dot)}-${suffix++}${baseName.slice(dot)}`; }
        usedNames.add(name); entries[name] = new Uint8Array(await output.blob.arrayBuffer());
      }
      const zip = zipSync(entries, { level: 0 }); const blob = new Blob([zip], { type: "application/zip" });
      const url = URL.createObjectURL(blob); const link = document.createElement("a"); link.href = url; link.download = "holi-images.zip"; link.click(); setTimeout(() => URL.revokeObjectURL(url), 1000); setStatus(labels.ready);
    } catch { setStatus(labels.failed); } finally { allDownload.disabled = false; }
  }

  function setMode(mode: string) {
    activeMode = mode;
    document.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => button.setAttribute("aria-selected", String(button.dataset.mode === mode)));
    document.querySelectorAll<HTMLElement>("[data-pane]").forEach((pane) => pane.hidden = pane.dataset.pane !== mode);
    const url = new URL(location.href); url.searchParams.set("mode", mode); history.replaceState({}, "", url);
    scheduleRender();
  }

  byId<HTMLButtonElement>("choose-images").addEventListener("click", () => input.click()); input.addEventListener("change", () => { if (input.files) addFiles(input.files); input.value = ""; });
  ["dragenter", "dragover"].forEach((event) => dropzone.addEventListener(event, (e) => { e.preventDefault(); dropzone.classList.add("is-dragging"); }));
  ["dragleave", "drop"].forEach((event) => dropzone.addEventListener(event, (e) => { e.preventDefault(); dropzone.classList.remove("is-dragging"); }));
  dropzone.addEventListener("drop", (event) => { if (event.dataTransfer?.files) addFiles(event.dataTransfer.files); });
  byId<HTMLButtonElement>("clear-images").addEventListener("click", () => { items.forEach((item) => { URL.revokeObjectURL(item.sourceUrl); if (item.outputUrl) URL.revokeObjectURL(item.outputUrl); }); items = []; activeId = ""; drawQueue(); clearPreview(); });
  compareRange.addEventListener("input", () => { const value = `${compareRange.value}%`; resultClip.style.clipPath = `inset(0 0 0 ${value})`; divider.style.left = value; });
  quality.addEventListener("input", syncQuality); outputFormat.addEventListener("change", scheduleRender); cropRatio.addEventListener("change", () => { const item = activeItem(); if (item && cropRatio.value !== "free") { const crop = centeredCrop(item.width, item.height, cropRatio.value as CropRatio); widthInput.value = String(crop.sw); heightInput.value = String(crop.sh); } scheduleRender(); });
  widthInput.addEventListener("input", () => { const item = activeItem(); if (item && lockRatio.checked) heightInput.value = String(Math.max(1, Math.round(Number(widthInput.value) / (item.width / item.height)))); scheduleRender(); });
  heightInput.addEventListener("input", () => { const item = activeItem(); if (item && lockRatio.checked) widthInput.value = String(Math.max(1, Math.round(Number(heightInput.value) * (item.width / item.height)))); scheduleRender(); });
  lockRatio.addEventListener("change", scheduleRender); document.querySelectorAll<HTMLButtonElement>("[data-mode]").forEach((button) => button.addEventListener("click", () => setMode(button.dataset.mode || "optimize")));
  byId<HTMLButtonElement>("reset-settings").addEventListener("click", () => { const item = activeItem(); quality.value = "82"; cropRatio.value = "free"; outputFormat.value = "original"; lockRatio.checked = true; if (item) { widthInput.value = String(item.width); heightInput.value = String(item.height); } syncQuality(); });
  currentDownload.addEventListener("click", () => { const item = activeItem(); if (item) download(item); }); allDownload.addEventListener("click", downloadZip);
  const initialMode = new URL(location.href).searchParams.get("mode"); if (initialMode && labels.modes[initialMode as keyof typeof labels.modes]) setMode(initialMode);
</script>

---
import MainLayout from "../../layouts/MainLayout.astro";
import { getLangFromUrl, languages } from "../../i18n/utils";
import { getMainChangelog } from "../../release";
import { DEFAULT_LANG } from "@holi/configs/i18n";

export function getStaticPaths() {
  return languages
    .filter((l) => l.code !== DEFAULT_LANG)
    .map((l) => ({
    params: { lang: l.code },
  }));
}

const lang = getLangFromUrl(Astro.url);
const history = getMainChangelog(lang);
const currentVersion = history[0]?.version || "0.0.0";
---

<MainLayout version={currentVersion} changelog={history} />

---
import { DEFAULT_LANG, SUPPORTED_LANGS } from "@holi/configs/i18n";
import TypstLayout from "../../layouts/TypstLayout.astro";
import { getTypstCopy } from "../../i18n/translations";
import "../../styles/app.css";

export function getStaticPaths() {
  return SUPPORTED_LANGS.filter((lang) => lang !== DEFAULT_LANG).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? DEFAULT_LANG;
const copy = getTypstCopy(lang);
---

<TypstLayout title={`${copy.privacyPage.title} · Holi Typst`} description={copy.privacySummary} lang={lang}>
  <main class="privacy-page">
    <a class="privacy-page__back" href={`/${lang}/`}>← {copy.privacyPage.back}</a>
    <header>
      <p class="privacy-page__eyebrow">Holi Typst</p>
      <h1>{copy.privacyPage.title}</h1>
      <p class="privacy-page__lead">{copy.privacyPage.lead}</p>
    </header>
    {copy.privacyPage.sections.map(([title, body]) => (
      <section>
        <h2>{title}</h2>
        <p>{body}</p>
      </section>
    ))}
    <p class="privacy-page__updated">{copy.privacyPage.updated}</p>
  </main>
</TypstLayout>

<style>
  .privacy-page { width: min(100% - 2rem, 48rem); margin: 0 auto; padding: 5rem 0 4rem; color: var(--color-text); }
  .privacy-page__back, .privacy-page__eyebrow, .privacy-page__updated { color: var(--text-muted); font-size: .82rem; }
  .privacy-page__back { display: inline-block; margin-bottom: 3rem; }
  .privacy-page__back:focus-visible { outline: 2px solid var(--color-accent); outline-offset: .25rem; }
  .privacy-page__eyebrow { margin: 0 0 .75rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  h1 { max-width: 18ch; margin: 0; font-size: clamp(2.4rem, 8vw, 5rem); line-height: .95; letter-spacing: -.055em; }
  .privacy-page__lead { margin: 1.5rem 0 4rem; color: var(--text-secondary); font-size: clamp(1.05rem, 3vw, 1.35rem); line-height: 1.55; }
  section { padding: 1.5rem 0; border-top: 1px solid var(--color-border); }
  h2 { margin: 0 0 .65rem; font-size: 1rem; }
  section p { margin: 0; color: var(--text-secondary); line-height: 1.7; }
  .privacy-page__updated { margin-top: 2rem; }
</style>

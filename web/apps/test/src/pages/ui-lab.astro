---
import BaseLayout from "@holi/ui/layouts/BaseLayout.astro";
import SimpleBackground from "@holi/ui/components/SimpleBackground.astro";
import Manual from "../components/Manual.astro";
import { getTranslations, languages } from "../i18n/translations";
import { testAppChangelog } from "@holi/configs/changelogs";

const lang = Astro.currentLocale || "en";
const t = getTranslations(lang);
const changelog = testAppChangelog;
---

<BaseLayout
  title="UI Component Lab"
  lang={lang}
  languages={languages}
  colorScheme="default"
  version="0.0.1"
  changelog={changelog}
>
  <SimpleBackground />
  <div class="mx-auto w-full max-w-5xl px-4 md:px-12 pt-24 pb-16">
    <div class="flex items-end justify-between gap-6 flex-wrap">
      <div>
        <div class="text-[10px] uppercase tracking-[0.4em] text-white/20 font-bold">
          holi-test / ui lab
        </div>
        <h1 class="mt-3 text-5xl md:text-6xl font-black lowercase tracking-tighter text-white">
          Components
        </h1>
        <p class="mt-3 text-white/40 font-light">
          Clean showcase. Floating panels are opt-in on the home page.
        </p>
      </div>
      <div class="flex gap-10 text-sm">
        <a class="link" href="/">Home</a>
        <a class="link" href="/vault">Vault</a>
        <a class="link" href="/p2p">P2P</a>
        <a class="link" href="/webgpu">WebGPU</a>
      </div>
    </div>

    <div class="mt-14">
      <Manual t={t} />
    </div>
  </div>

  <style>
    .link {
      color: rgba(255,255,255,0.55);
      text-decoration: none;
      font-weight: 700;
      padding: 6px 10px;
      border-radius: 10px;
      border: 1px solid transparent;
    }
    .link:hover {
      color: rgba(255,255,255,0.9);
      border-color: rgba(255,255,255,0.10);
      background: rgba(255,255,255,0.04);
    }
  </style>
</BaseLayout>

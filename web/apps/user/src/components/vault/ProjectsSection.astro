---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = `/${lang}`;

const strings = {
  title: t("projects.title"),
  desc: t("projects.desc"),
  join_button: t("projects.join_button"),
  new_button: t("projects.new_button"),
  no_projects: t("projects.no_projects"),
  noProjectsDesc: t("projects.no_projects_desc"),
  noVault: t("projects.no_vault"),
  noVaultDesc: t("projects.no_vault_desc"),
  openVault: t("projects.open_vault"),
  createFirst: t("projects.create_first"),
  owner: t("projects.owner"),
  member: t("projects.member"),
  updated: t("projects.updated"),
  offline: t("projects.offline"),
  chat: t("projects.chat"),
  settings: t("projects.settings"),
  delete: t("projects.delete"),
  label: t("projects.label"),
  deleteConfirm: t("projects.delete_confirm"),
  deletedToast: t("projects.deleted_toast"),
  failedLoad: t("projects.failed_load"),
};
---

<section id="projects-section" class="space-y-5" aria-labelledby="projects-heading">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h2 id="projects-heading" class="text-lg font-bold text-white">{strings.title}</h2>
      <p class="mt-1 text-sm leading-5 text-zinc-500">{strings.desc}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        id="join-project-btn"
        class="rounded-xl border border-white/10 bg-white/[0.04] px-3 py-2 text-xs font-semibold text-zinc-300 transition hover:bg-white/[0.08] disabled:cursor-not-allowed disabled:opacity-40"
        disabled
      >
        {strings.join_button}
      </button>
      <button
        type="button"
        id="new-project-btn"
        class="rounded-xl bg-violet-600 px-3 py-2 text-xs font-bold text-white transition hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-40"
        disabled
      >
        {strings.new_button}
      </button>
    </div>
  </div>

  <div
    id="projects-grid"
    class="grid grid-cols-1 gap-3 sm:grid-cols-2"
    aria-live="polite"
  >
    <div class="h-40 animate-pulse rounded-2xl border border-white/5 bg-white/[0.035]"></div>
    <div class="hidden h-40 animate-pulse rounded-2xl border border-white/5 bg-white/[0.035] sm:block"></div>
  </div>

  <div
    id="empty-projects"
    class="hidden rounded-2xl border border-dashed border-white/10 bg-white/[0.025] px-5 py-8 text-center"
    aria-live="polite"
  >
    <div class="mx-auto grid h-11 w-11 place-items-center rounded-2xl bg-violet-400/10 text-violet-300">
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h6l2 2h12v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2Z"/><path d="M12 13v4m-2-2h4"/></svg>
    </div>
    <p id="empty-projects-title" class="mt-3 text-sm font-bold text-zinc-200">{strings.no_projects}</p>
    <p id="empty-projects-desc" class="mx-auto mt-1 max-w-sm text-xs leading-5 text-zinc-500">{strings.noProjectsDesc}</p>
    <button id="empty-projects-action" type="button" class="mt-4 rounded-xl border border-white/10 bg-white/[0.06] px-3 py-2 text-xs font-bold text-white transition hover:bg-white/10">
      {strings.createFirst}
    </button>
  </div>
</section>

<script define:vars={{ strings, basePath }}>
  window.projectStrings = strings;
  window.projectBasePath = basePath;
</script>

<script>
  import { getProjects, deleteProject } from "../../lib/projects/manager";
  import { toast } from "../../lib/ui/toast";
  import { getActiveHandle } from "../../lib/workspace";

  // Replicate logic for project loading
  let projects: any[] = [];
  const grid = document.getElementById("projects-grid");
  const empty = document.getElementById("empty-projects");
  const emptyTitle = document.getElementById("empty-projects-title");
  const emptyDesc = document.getElementById("empty-projects-desc");
  const emptyAction = document.getElementById(
    "empty-projects-action"
  ) as HTMLButtonElement | null;
  const newBtn = document.getElementById(
    "new-project-btn"
  ) as HTMLButtonElement;
  const joinBtn = document.getElementById(
    "join-project-btn"
  ) as HTMLButtonElement;

  const strings = (window as any).projectStrings;
  const basePath = (window as any).projectBasePath || "";
  let emptyActionMode: "vault" | "create" = "vault";

  function escapeHtml(value: unknown): string {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  export async function loadProjects() {
    if (!grid) return;

    if (!getActiveHandle()) {
      grid.classList.add("hidden");
      empty?.classList.remove("hidden");
      if (emptyTitle) emptyTitle.textContent = strings.noVault;
      if (emptyDesc) emptyDesc.textContent = strings.noVaultDesc;
      if (emptyAction) emptyAction.textContent = strings.openVault;
      emptyActionMode = "vault";
      newBtn.disabled = true;
      joinBtn.disabled = true;
      return;
    }

    try {
      newBtn.disabled = false;
      joinBtn.disabled = false;
      const list = await getProjects();
      projects = list;

      if (projects.length === 0) {
        grid.innerHTML = "";
        grid.classList.add("hidden");
        empty?.classList.remove("hidden");
        if (emptyTitle) emptyTitle.textContent = strings.no_projects;
        if (emptyDesc) emptyDesc.textContent = strings.noProjectsDesc;
        if (emptyAction) emptyAction.textContent = strings.createFirst;
        emptyActionMode = "create";
        return;
      }

      empty?.classList.add("hidden");
      grid.classList.remove("hidden");
      grid.innerHTML = "";

      for (const p of projects) {
        const projectId = String(p.id ?? "");
        const safeId = escapeHtml(projectId);
        const safeName = escapeHtml(p.name);
        const role = p.role === "owner" ? strings.owner : strings.member;
        const safeRole = escapeHtml(role);
        const date = new Date(p.updatedAt);
        const formattedDate = Number.isNaN(date.getTime())
          ? ""
          : new Intl.DateTimeFormat(document.documentElement.lang || undefined, {
              month: "short",
              day: "numeric",
            }).format(date);
        const safeUpdatedAt = escapeHtml(
          strings.updated.replace("{date}", formattedDate)
        );
        const card = document.createElement("article");
        card.className =
          "project-card group relative cursor-pointer overflow-hidden rounded-2xl border border-white/[0.07] bg-white/[0.035] p-5 transition hover:-translate-y-0.5 hover:border-violet-300/20 hover:bg-white/[0.065] hover:shadow-xl";
        card.tabIndex = 0;
        card.setAttribute("role", "link");
        card.setAttribute("aria-label", `${strings.chat}: ${String(p.name ?? "")}`);

        card.innerHTML = `
                    <div class="absolute right-0 top-0 flex gap-2 p-3 opacity-100 transition-opacity sm:opacity-0 sm:group-hover:opacity-100 sm:group-focus-within:opacity-100">
                        <button type="button" class="project-manage-btn rounded-lg bg-zinc-800 p-1.5 text-zinc-400 hover:text-white" aria-label="${escapeHtml(strings.settings)}" title="${escapeHtml(strings.settings)}" data-id="${safeId}">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.38a2 2 0 0 0-.73-2.73l-.15-.1a2 2 0 0 1-1-1.72v-.51a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        </button>
                        <button type="button" class="project-delete-btn rounded-lg bg-red-500/10 p-1.5 text-red-400 hover:bg-red-500/20" aria-label="${escapeHtml(strings.delete)}" title="${escapeHtml(strings.delete)}" data-id="${safeId}">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </button>
                    </div>

                    <div class="mb-4">
                        <div class="flex items-center gap-2 mb-2">
                            <span class="rounded-lg bg-violet-500/15 p-1.5 text-violet-300">
                                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                            </span>
                            <span class="text-xs font-bold uppercase tracking-wider text-violet-300">${escapeHtml(strings.label)}</span>
                        </div>
                        <h4 class="text-white font-bold text-lg leading-tight truncate px-1">${safeName}</h4>
                        <div class="flex items-center gap-2 mt-2 px-1">
                            <span class="text-[10px] font-mono text-zinc-500 bg-white/5 px-1.5 py-0.5 rounded">${safeRole}</span>
                            <span class="text-[10px] font-mono text-zinc-500">${safeUpdatedAt}</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-4 border-t border-white/5">
                        <span class="text-xs text-zinc-500 flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-zinc-600"></span>
                            ${escapeHtml(strings.offline)}
                        </span>
                        
                        <button type="button" class="project-chat-btn group/chat flex items-center gap-1 rounded-md px-2 py-1 text-xs text-zinc-400 transition-colors hover:bg-white/5 hover:text-white" data-id="${safeId}">
                            <svg class="w-3.5 h-3.5 group-hover/chat:text-purple-400 transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                            ${escapeHtml(strings.chat)}
                        </button>
                    </div>
                 `;

        card.addEventListener("click", (e) => {
          // Check if clicked button
          if ((e.target as HTMLElement).closest("button")) return;
          window.location.href = `${basePath}/vault#${encodeURIComponent(projectId)}`;
        });
        card.addEventListener("keydown", (e) => {
          if (e.key === "Enter" || e.key === " ") {
            if ((e.target as HTMLElement).closest("button")) return;
            e.preventDefault();
            window.location.href = `${basePath}/vault#${encodeURIComponent(projectId)}`;
          }
        });

        // Wire buttons
        const manageBtn = card.querySelector(".project-manage-btn");
        manageBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          window.dispatchEvent(
            new CustomEvent("open-manage-project", { detail: { id: projectId } })
          );
        });

        const chatBtn = card.querySelector(".project-chat-btn");
        chatBtn?.addEventListener("click", (e) => {
          e.stopPropagation();
          window.location.href = `${basePath}/vault?chat=1#${encodeURIComponent(projectId)}`;
        });

        const delBtn = card.querySelector(".project-delete-btn");
        delBtn?.addEventListener("click", async (e) => {
          e.stopPropagation();
          if (confirm(strings.deleteConfirm.replace("{name}", String(p.name ?? "")))) {
            await deleteProject(projectId);
            toast.success(strings.deletedToast);
            loadProjects();
          }
        });

        grid.appendChild(card);
      }
    } catch (e) {
      console.error(e);
      toast.error(strings.failedLoad);
    }
  }

  newBtn?.addEventListener("click", () => {
    window.dispatchEvent(
      new CustomEvent("open-project-modal", { detail: { mode: "create" } })
    );
  });
  joinBtn?.addEventListener("click", () => {
    window.dispatchEvent(
      new CustomEvent("open-project-modal", { detail: { mode: "join" } })
    );
  });
  emptyAction?.addEventListener("click", () => {
    if (emptyActionMode === "vault") {
      document.getElementById("select-vault-btn")?.click();
      return;
    }
    window.dispatchEvent(
      new CustomEvent("open-project-modal", { detail: { mode: "create" } })
    );
  });

  // Export active reloader
  window.addEventListener("repo-changed", loadProjects); // Custom event if needed
  window.addEventListener("workspace-restored", loadProjects);
  loadProjects();
</script>

<style>
  .project-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
  }
</style>

---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const basePath = `/${lang}`;

const strings = {
  title: t("friends.title"),
  desc: t("friends.desc"),
  search_placeholder: t("friends.search_placeholder"),
  toggle_blocked: t("friends.toggle_blocked"),
  copy_code: t("friends.copy_code"),
  add_button: t("friends.add_button"),
  no_vault_warning: t("friends.no_vault_warning"),
  loading: t("friends.loading"),
  no_vault_error: t("friends.no_vault_error"),
  failed_load: t("friends.failed_load"),
  no_matches: t("friends.no_matches"),
  empty: t("friends.empty"),
  empty_desc: t("friends.empty_desc"),
  local_only: t("friends.local_only"),
  blocked: t("friends.blocked"),
  trusted: t("friends.trusted"),
  paused: t("friends.paused"),
  delete_confirm: t("friends.delete_confirm"),
  removed_toast: t("friends.removed_toast"),
  code_copied: t("friends.code_copied"),
  code_already_copied: t("friends.code_already_copied"),
  code_expired: t("friends.code_expired"),
  confirm_accept: t("friends.confirm_accept"),
  toast_rejected: t("friends.toast_rejected"),
  toast_added: t("friends.toast_added"),
  invite_failed: t("friends.invite_failed"),
  state_changed: t("friends.state_changed"),
  chat_label: t("friends.chat_label"),
  edit_label: t("friends.edit_label"),
  delete_label: t("friends.delete_label"),
  status_label: t("friends.status_label"),
};
---

<section id="friends-section" class="space-y-5" aria-labelledby="friends-heading">
  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
    <div>
      <div class="flex items-center gap-3">
        <h2 id="friends-heading" class="text-lg font-bold text-white">{strings.title}</h2>
        <span id="friend-count" class="rounded-md bg-white/5 px-2 py-0.5 text-xs text-zinc-500" aria-label={strings.title}>0</span>
      </div>
      <p class="mt-1 text-sm leading-5 text-zinc-500">{strings.desc}</p>
    </div>

    <!-- Filter & Actions -->
    <div class="flex w-full flex-wrap items-center gap-2 lg:w-auto lg:justify-end">
      <div class="relative min-w-[12rem] flex-1 lg:w-64 lg:flex-none">
        <input
          type="text"
          id="friend-search"
          aria-label={strings.search_placeholder}
          placeholder={strings.search_placeholder}
          class="w-full pl-8 pr-3 py-1.5 bg-white/5 border border-white/10 rounded-lg text-xs text-white focus:border-purple-500 focus:outline-none transition-colors"
        />
        <svg
          class="absolute left-2.5 top-1.5 text-zinc-500 w-3.5 h-3.5"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
        >
      </div>

      <button
        type="button"
        id="toggle-blocked-btn"
        class="rounded-lg bg-white/5 p-2 text-zinc-400 transition-colors hover:bg-white/10 hover:text-white"
        title={strings.toggle_blocked}
        aria-label={strings.toggle_blocked}
        aria-pressed="true"
      >
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          ><path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268-2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"
          ></path></svg
        >
      </button>

      <div class="h-6 w-px bg-white/10 mx-1"></div>

      <button
        type="button"
        id="copy-friend-code-btn"
        class="hidden rounded-lg bg-white/5 p-2 text-zinc-300 transition-colors hover:bg-white/10"
        title={strings.copy_code}
        aria-label={strings.copy_code}
      >
        <svg
          class="w-4 h-4"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          ><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path
            d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
          ></path></svg
        >
      </button>
      <button
        type="button"
        id="add-friend-btn"
        class="whitespace-nowrap rounded-xl bg-violet-600 px-3 py-2 text-xs font-bold text-white transition-colors hover:bg-violet-500 disabled:cursor-not-allowed disabled:opacity-40"
        disabled
      >
        {strings.add_button}
      </button>
    </div>
  </div>

  <div
    id="no-friends-warning"
    class="hidden rounded-2xl border border-amber-300/15 bg-amber-300/[0.07] p-4 text-sm text-amber-200"
    role="status"
  >
    {strings.no_vault_warning}
  </div>

  <!-- Friends List Container -->
  <div id="friends-list" class="space-y-2" aria-live="polite">
    <p class="text-xs text-zinc-500 italic p-4 text-center">
      {strings.loading}
    </p>
  </div>
</section>

<script define:vars={{ strings, basePath }}>
  window.friendStrings = strings;
  window.friendBasePath = basePath;
</script>

<script>
  import { listContacts, setContactState } from "../../lib/contacts/store";
  import { identityStore } from "../../lib/stores/identity";
  import { toast } from "../../lib/ui/toast";

  // Note: openFriendDialog is handled via Custom Events

  // Note: openFriendDialog is likely a function exported from the script logic or handled via event.
  // For now, we will dispatch events to open global modals or implement logic here.

  const strings = (window as any).friendStrings;
  const basePath = (window as any).friendBasePath || "";

  let contacts: any[] = [];
  const HIDE_BLOCKED_KEY = "holi.user.friends.hideBlocked.v1";
  let hideBlocked = true;
  let friendSearchQuery = "";
  let myPubkey = "";

  const listEl = document.getElementById("friends-list");
  const countEl = document.getElementById("friend-count");
  const addBtn = document.getElementById("add-friend-btn") as HTMLButtonElement;
  const copyBtn = document.getElementById("copy-friend-code-btn");
  const searchInput = document.getElementById(
    "friend-search"
  ) as HTMLInputElement;
  const toggleBlockedBtn = document.getElementById("toggle-blocked-btn");
  const noVaultWarning = document.getElementById("no-friends-warning");

  // Default to hiding blocked friends; persist preference locally.
  try {
    const raw = window.localStorage.getItem(HIDE_BLOCKED_KEY);
    if (raw === "0") hideBlocked = false;
  } catch {}

  function syncHideBlockedUi() {
    if (!toggleBlockedBtn) return;
    toggleBlockedBtn.classList.toggle("text-purple-400", hideBlocked);
    toggleBlockedBtn.classList.toggle("bg-purple-500/10", hideBlocked);
    toggleBlockedBtn.setAttribute("aria-pressed", String(hideBlocked));
  }

  identityStore.subscribe(({ pubkey, identity }) => {
    myPubkey = pubkey || "";
    // addBtn state is managed by loadContacts() based on workspace availability
    // identity logic mostly affects invites but for adding friends, we just need a vault.

    if (copyBtn) {
      if (pubkey) copyBtn.classList.remove("hidden");
      else copyBtn.classList.add("hidden");
    }
  });

  // Event Listeners
  addBtn?.addEventListener("click", () => {
    // Dispatch event to open Friend Modal
    window.dispatchEvent(
      new CustomEvent("open-friend-modal", { detail: { mode: "add" } })
    );
  });

  // State for hosting
  let isHosting = false;
  let activeRoom: { leave: () => void } | null = null;

  copyBtn?.addEventListener("click", async () => {
    if (!myPubkey) return;
    if (isHosting) {
      // Already hosting, just copy
      toast.info(strings.code_already_copied);
      return;
    }

    try {
      const { generateFriendCode, hostFriendRoom } =
        await import("../../lib/friends/friend-handshake");
      const { getPrimaryIdentity } = await import("../../lib/identity/manager");
      const { generateDmConfig } = await import("../../lib/friends/dm");
      const { addContactWithNostrPubkey, setContactDmByNostrPubkey } =
        await import("../../lib/contacts/store");

      const code = generateFriendCode();
      const inviteUrl = `${window.location.origin}${basePath}/friend#${code}`;
      await navigator.clipboard.writeText(inviteUrl);
      toast.success(strings.code_copied);

      isHosting = true;
      copyBtn.classList.add("animate-pulse", "text-green-400");

      const myself = await getPrimaryIdentity();
      const pk = myself?.id || "";
      const dm = generateDmConfig();

      const myInfo = {
        pubkey: pk,
        name: myself?.alias || "Friend",
        dm,
      };

      activeRoom = hostFriendRoom(code, myInfo, async (peerInfo) => {
      const label = peerInfo?.name
        ? `${peerInfo.name} (${String(peerInfo.pubkey || "").slice(0, 8)}…)`
        : String(peerInfo.pubkey || "").slice(0, 8);

      const ok = confirm(strings.confirm_accept.replace("{name}", label));
      if (!ok) {
        toast.info(strings.toast_rejected);
        return false;
      }

      // Accept: persist contact + DM config (host dm config is authoritative)
      await addContactWithNostrPubkey(peerInfo.name, peerInfo.pubkey);
      await setContactDmByNostrPubkey(peerInfo.pubkey, dm);

      toast.success(
        strings.toast_added.replace("{name}", peerInfo.name || "Friend")
      );

      // Cleanup hosting UI (the handshake room will auto-close after accept)
      isHosting = false;
      copyBtn.classList.remove("animate-pulse", "text-green-400");
      activeRoom = null;

      window.dispatchEvent(new Event("reload-contacts"));
      return true;
      });

      setTimeout(() => {
        if (isHosting) {
          isHosting = false;
          copyBtn.classList.remove("animate-pulse", "text-green-400");
          if (activeRoom) {
            activeRoom.leave();
            activeRoom = null;
          }
          toast.info(strings.code_expired);
        }
      }, 120000);
    } catch (error) {
      console.error(error);
      isHosting = false;
      copyBtn.classList.remove("animate-pulse", "text-green-400");
      toast.error(strings.invite_failed);
    }
  });

  searchInput?.addEventListener("input", (e) => {
    friendSearchQuery = (e.target as HTMLInputElement).value.toLowerCase();
    renderContacts();
  });

  toggleBlockedBtn?.addEventListener("click", () => {
    hideBlocked = !hideBlocked;
    try {
      window.localStorage.setItem(HIDE_BLOCKED_KEY, hideBlocked ? "1" : "0");
    } catch {}
    syncHideBlockedUi();
    renderContacts();
  });

  // Expose load logic
  export async function loadContacts() {
    if (!listEl) return;

    // Check if workspace is active
    const { getActiveHandle } = await import("../../lib/workspace");
    if (!getActiveHandle()) {
      listEl.innerHTML = "";
      listEl.className = "space-y-2";
      noVaultWarning?.classList.remove("hidden");
      if (countEl) countEl.textContent = "0";
      if (addBtn) addBtn.disabled = true;
      return;
    }

    try {
      noVaultWarning?.classList.add("hidden");
      listEl.innerHTML = `<p class="text-xs text-zinc-500 italic animate-pulse p-4 text-center">${strings.loading}</p>`;
      contacts = await listContacts();
      renderContacts();
      if (addBtn) addBtn.disabled = false;
    } catch (e) {
      console.error(e);
      listEl.innerHTML = `<p class="text-xs text-red-400 p-4 text-center">${strings.failed_load}</p>`;
    }
  }

  // Export for parent to call active reload
  window.addEventListener("workspace-restored", loadContacts);
  window.addEventListener("reload-contacts", loadContacts);

  function renderContacts() {
    if (!listEl) return;

    const filtered = contacts.filter((c) => {
      if (hideBlocked && c.state === "blocked") return false;
      if (friendSearchQuery) {
        const key = (c.nostrPubkey || "").toLowerCase();
        const name = c.alias.toLowerCase();
        return (
          name.includes(friendSearchQuery) || key.includes(friendSearchQuery)
        );
      }
      return true;
    });

    if (countEl) countEl.textContent = String(filtered.length);

    if (filtered.length === 0) {
      listEl.className = "space-y-2";
      const hasSearch = Boolean(friendSearchQuery);
      listEl.innerHTML = hasSearch
        ? `<div class="rounded-2xl border border-dashed border-white/10 px-5 py-8 text-center text-sm text-zinc-500">${strings.no_matches}</div>`
        : `<div class="rounded-2xl border border-dashed border-white/10 bg-white/[0.02] px-5 py-8 text-center"><p class="text-sm font-bold text-zinc-200">${strings.empty}</p><p class="mx-auto mt-1 max-w-md text-xs leading-5 text-zinc-500">${strings.empty_desc}</p></div>`;
      return;
    }

    listEl.innerHTML = "";
    listEl.classList.add("grid", "grid-cols-1", "gap-2");

    for (const c of filtered) {
      const row = document.createElement("div");
      row.className =
        "group flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5 hover:bg-white/10 transition-all hover:shadow-lg hover:border-white/10";

      // ... DOM construction (copied from Dashboard with minor tweaks)

      // Avatar & Info
      const left = document.createElement("div");
      left.className = "flex items-center gap-3 min-w-0";

      const avatar = document.createElement("div");
      avatar.className =
        "w-10 h-10 rounded-full bg-zinc-800 flex items-center justify-center text-sm font-bold text-zinc-400 border border-white/10";
      avatar.textContent = c.alias.slice(0, 2).toUpperCase();

      const info = document.createElement("div");
      info.className = "min-w-0";

      const nameRow = document.createElement("div");
      nameRow.className = "flex items-center gap-2";
      const name = document.createElement("span");
      name.className = "text-sm text-white font-medium truncate";
      name.textContent = c.alias;
      nameRow.appendChild(name);

      const tag = document.createElement("div");
      tag.className = "text-xs text-zinc-500 font-mono truncate";
      const shortKey = c.nostrPubkey
        ? c.nostrPubkey.slice(0, 8) + "..." + c.nostrPubkey.slice(-4)
        : strings.local_only;
      tag.textContent =
        c.state === "blocked" ? strings.blocked + " • " + shortKey : shortKey;

      info.appendChild(nameRow);
      info.appendChild(tag);

      left.appendChild(avatar);
      left.appendChild(info);

      // Actions
      const actions = document.createElement("div");
      actions.className = "flex gap-2 items-center";

      // Status Dropdown (Simplified for this file)
      const statusContainer = document.createElement("div");
      statusContainer.className = "relative";
      const statusBtn = document.createElement("button");
      statusBtn.type = "button";
      statusBtn.setAttribute(
        "aria-label",
        strings.status_label.replace("{name}", c.alias)
      );
      const statusColor =
        c.state === "active"
          ? "bg-green-500/20 text-green-400"
          : c.state === "paused"
            ? "bg-yellow-500/20 text-yellow-400"
            : "bg-red-500/20 text-red-400";
      statusBtn.className = `px-2 py-1 text-xs rounded-md font-medium transition-colors flex items-center gap-1 ${statusColor}`;

      const displayState =
        c.state === "active"
          ? strings.trusted
          : c.state === "blocked"
            ? strings.blocked
            : strings.paused || c.state;
      statusBtn.innerHTML = `<span>${displayState}</span><svg class="w-3 h-3 opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>`;

      statusBtn.onclick = (e) => {
        e.stopPropagation();
        document.querySelectorAll(".status-menu").forEach((el) => el.remove());
        const menu = document.createElement("div");
        menu.className =
          "status-menu absolute right-0 top-full mt-1 w-24 bg-zinc-900 border border-white/10 rounded-lg shadow-xl overflow-hidden z-10";
        ["active", "paused", "blocked"].forEach((state) => {
          if (state === c.state) return;
          const item = document.createElement("button");
          item.type = "button";
          item.className =
            "w-full text-left px-3 py-2 text-xs hover:bg-white/10 text-zinc-300 capitalize";
          item.textContent =
            state === "active"
              ? strings.trusted
              : state === "paused"
                ? strings.paused
                : strings.blocked;
          item.onclick = async () => {
            await setContactState(c.id, state as any);
            toast.info(
              strings.state_changed.replace("{state}", item.textContent || state)
            );
            menu.remove();
            await loadContacts();
          };
          menu.appendChild(item);
        });
        const closeMenu = () => {
          menu.remove();
          document.removeEventListener("click", closeMenu);
        };
        setTimeout(() => document.addEventListener("click", closeMenu), 0);
        statusContainer.appendChild(menu);
      };
      statusContainer.appendChild(statusBtn);

      // Chat Button
      const chatBtn = document.createElement("button");
      chatBtn.type = "button";
      chatBtn.disabled = !c.nostrPubkey;
      chatBtn.setAttribute(
        "aria-label",
        strings.chat_label.replace("{name}", c.alias)
      );
      chatBtn.title = strings.chat_label.replace("{name}", c.alias);
      chatBtn.className = `p-2 rounded-lg transition-colors ${c.nostrPubkey ? "text-zinc-400 hover:text-white hover:bg-white/10" : "text-zinc-600 cursor-not-allowed"}`;
      chatBtn.innerHTML = `<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>`;
      if (c.nostrPubkey) {
        chatBtn.onclick = () =>
          (window.location.href = `${basePath}/dm#pk=${c.nostrPubkey}`);
      }

      // Edit Button (Rename)
      const editBtn = document.createElement("button");
      editBtn.type = "button";
      editBtn.setAttribute(
        "aria-label",
        strings.edit_label.replace("{name}", c.alias)
      );
      editBtn.title = strings.edit_label.replace("{name}", c.alias);
      editBtn.className =
        "p-2 rounded-lg text-zinc-400 hover:text-white hover:bg-white/10 transition-colors";
      editBtn.innerHTML = `<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>`;
      editBtn.onclick = () => {
        window.dispatchEvent(
          new CustomEvent("open-friend-modal", {
            detail: { mode: "edit", contact: c },
          })
        );
      };

      // Delete Button
      const deleteBtn = document.createElement("button");
      deleteBtn.type = "button";
      deleteBtn.setAttribute(
        "aria-label",
        strings.delete_label.replace("{name}", c.alias)
      );
      deleteBtn.title = strings.delete_label.replace("{name}", c.alias);
      deleteBtn.className =
        "p-2 rounded-lg text-zinc-400 hover:text-red-400 hover:bg-red-500/10 transition-colors";
      deleteBtn.innerHTML = `<svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>`;
      deleteBtn.onclick = async () => {
        if (confirm(strings.delete_confirm.replace("{name}", c.alias))) {
          const { removeContact } = await import("../../lib/contacts/store");
          await removeContact(c.id);
          toast.success(strings.removed_toast);
          loadContacts();
        }
      };

      actions.appendChild(statusContainer);
      actions.appendChild(chatBtn);
      actions.appendChild(editBtn);
      actions.appendChild(deleteBtn);

      row.appendChild(left);
      row.appendChild(actions);
      listEl.appendChild(row);
    }
  }

  // Initial Load
  syncHideBlockedUi();
  loadContacts();
</script>

---
import { getUserPrivacy } from "../privacy";
import { getProductShellCopy } from "@holi/ui/lib/product-shell-copy";

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const content = getUserPrivacy(lang);
const shellCopy = getProductShellCopy(lang);
---

<div class="info-overlay" id="overlay-info-about" style="display: none;">
  <div
    class="log-backdrop"
    onclick="window.closeOverlay && window.closeOverlay('info', 'about')"
  ></div>

  <aside class="log-drawer">
    <header class="log-header">
      <h2 class="log-title">{content.aboutTitle}</h2>
      <button
        class="log-close-btn"
        onclick="window.closeOverlay && window.closeOverlay('info', 'about')"
        aria-label={shellCopy.close}
      >
        ×
      </button>
    </header>

    <div class="log-body">
      <p class="info-text">{content.aboutBody}</p>
    </div>

    <footer class="log-footer">
      <p>holi.tools</p>
    </footer>
  </aside>
</div>

<style>
  /* Reuse ChangelogOverlay animation contract (log-backdrop/log-drawer) */
  .info-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
  }

  .info-text {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary, rgba(26, 26, 26, 0.7));
  }

  @media (prefers-color-scheme: dark) {
    .info-text {
      color: var(--text-secondary, rgba(255, 255, 255, 0.7));
    }
  }

  .log-close-btn {
    font-size: 22px;
    line-height: 1;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
  }
</style>

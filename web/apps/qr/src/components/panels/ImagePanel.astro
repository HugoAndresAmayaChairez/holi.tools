---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/**
 * ImagePanel.astro - Unified Image Management
 *
 * Combines Logo and Background Art into single panel with:
 * - Quick presets: "Logo" and "Background"
 * - Shared image upload
 * - Mode-specific controls
 */
---

<div class="image-panel-content">
  <!-- Mode Selector (Quick Presets) -->
  <div class="mode-selector">
    <div class="mode-item">
      <button
        class="mode-btn active"
        id="mode-bg"
        onclick="setImageMode('bg')"
      >
        <span class="mode-thumb" id="thumb-bg" aria-hidden="true">
          <span class="mode-thumb-icon icon">image</span>
        </span>
        <span class="mode-label">{t("image.background")}</span>
      </button>
      <button
        class="mode-clear"
        id="clear-bg"
        type="button"
        title={t("image.remove")}
        onclick="clearImageSlot(event, 'bg')"
      >
        ×
      </button>
    </div>
    <div class="mode-item">
      <button
        class="mode-btn"
        id="mode-paper"
        onclick="setImageMode('paper')"
      >
        <span class="mode-thumb" id="thumb-paper" aria-hidden="true">
          <span class="mode-thumb-icon icon">photo</span>
        </span>
        <span class="mode-label">{t("image.paper")}</span>
      </button>
      <button
        class="mode-clear"
        id="clear-paper"
        type="button"
        title={t("image.remove")}
        onclick="clearImageSlot(event, 'paper')"
      >
        ×
      </button>
    </div>
    <div class="mode-item">
      <button
        class="mode-btn"
        id="mode-ink"
        onclick="setImageMode('ink')"
      >
        <span class="mode-thumb" id="thumb-ink" aria-hidden="true">
          <span class="mode-thumb-icon icon">brush</span>
        </span>
        <span class="mode-label">{t("image.ink")}</span>
      </button>
      <button
        class="mode-clear"
        id="clear-ink"
        type="button"
        title={t("image.remove")}
        onclick="clearImageSlot(event, 'ink')"
      >
        ×
      </button>
    </div>
    <div class="mode-item">
      <button class="mode-btn" id="mode-logo" onclick="setImageMode('logo')">
        <span class="mode-thumb" id="thumb-logo" aria-hidden="true">
          <span class="mode-thumb-icon icon">add_photo_alternate</span>
        </span>
        <span class="mode-label">{t("image.logo")}</span>
      </button>
      <button
        class="mode-clear"
        id="clear-logo"
        type="button"
        title={t("image.remove")}
        onclick="clearImageSlot(event, 'logo')"
      >
        ×
      </button>
    </div>
  </div>

  <!-- Image Upload Area -->
  <div class="image-upload-area" id="image-upload-area">
    <div class="upload-placeholder" id="image-placeholder">
      <div class="upload-icon icon">upload_file</div>
      <div class="upload-text">{t("image.drop")}</div>
      <div class="upload-subtext">{t("image.browse")}</div>
      <input
        type="file"
        accept="image/*"
        id="image-input"
        onchange="handleImageUpload(event)"
      />
    </div>

    <div class="image-preview" id="image-preview" style="display:none;">
      <div class="preview-container">
        <img id="preview-img" alt="Preview" />
        <button
          class="preview-remove"
          onclick="removeImage()"
          title={t("image.remove")}>×</button
        >
      </div>
      <button
        class="change-btn"
        onclick="document.getElementById('image-input').click()"
        ><span class="icon">refresh</span> {t("image.change")}</button
      >
    </div>
  </div>

  <!-- Logo Mode Controls -->
  <div class="controls-section" id="logo-controls" style="display:none;">
    <div class="control-row">
      <label class="control-label">
        {t("image.opacity")}
        <span class="control-value" id="logo-opacity-val">100%</span>
      </label>
      <input
        type="range"
        id="logo-opacity"
        min="0"
        max="100"
        value="100"
        oninput="updateLogoOpacity(this.value)"
      />
    </div>

    <div class="control-row">
      <label class="control-label">
        {t("image.size")}
        <span class="control-value" id="logo-size-val">20%</span>
      </label>
      <input
        type="range"
        id="logo-size"
        min="5"
        max="50"
        value="20"
        oninput="updateLogoSize(this.value)"
      />
    </div>

    <div class="control-group">
      <label class="control-label">{t("image.fit")}</label>
      <div class="fit-buttons">
        <button class="fit-btn" data-logo-fit="cover" onclick="setLogoFit('cover')">{t("image.cover")}</button>
        <button class="fit-btn active" data-logo-fit="contain" onclick="setLogoFit('contain')">{t("image.contain")}</button>
        <button class="fit-btn" data-logo-fit="fill" onclick="setLogoFit('fill')">{t("image.fill")}</button>
      </div>
    </div>

    <div class="control-row">
      <label class="control-label">{t("image.bg_container")}</label>
      <label class="toggle-switch">
        <input
          type="checkbox"
          id="logo-bg-toggle"
          checked
          onchange="updateLogoBg(this.checked)"
        />
        <span class="toggle-slider"></span>
      </label>
    </div>

    <div class="control-row" id="logo-bg-color-row">
      <label class="control-label">{t("image.bg_color")}</label>
      <input type="color" id="logo-bg-color" value="#ffffff" onchange="updateLogoBgColor(this.value)" />
    </div>

    <!-- Shape Controls -->
    <div class="control-group" id="logo-shape-group">
      <label class="control-label">{t("image.container_shape")}</label>
      <div class="fit-buttons">
        <button
          class="fit-btn active"
          data-shape="square"
          onclick="setLogoShape('square')">{t("image.square")}</button
        >
        <button
          class="fit-btn"
          data-shape="rounded"
          onclick="setLogoShape('rounded')">{t("image.rounded")}</button
        >
        <button
          class="fit-btn"
          data-shape="circle"
          onclick="setLogoShape('circle')">{t("image.circle")}</button
        >
      </div>
    </div>

    <!-- Rounded Options -->
    <div class="control-row" id="logo-radius-row" style="display:none;">
      <label class="control-label">
        {t("image.corner_radius")}
        <span class="control-value" id="logo-radius-val">10</span>
      </label>
      <input
        type="range"
        id="logo-radius"
        min="0"
        max="50"
        value="10"
        oninput="updateLogoRadius(this.value)"
      />
    </div>

    <div class="control-row">
      <label class="control-label">
        {t("image.padding")}
        <span class="control-value" id="logo-padding-val">0</span>
      </label>
      <input
        type="range"
        id="logo-padding"
        min="0"
        max="50"
        value="0"
        oninput="updateLogoPadding(this.value)"
      />
    </div>

    <div class="transform-section">
      <label class="control-label section-title">{t("image.transform")}</label>

      <div class="control-row">
        <label class="control-label">
          {t("image.rotation")}
          <span class="control-value" id="logo-rotation-val">0°</span>
        </label>
        <input type="range" id="logo-rotation" min="-180" max="180" value="0" oninput="updateLogoRotation(this.value)" />
      </div>

      <div class="control-row">
        <label class="control-label">
          {t("image.scale")}
          <span class="control-value" id="logo-scale-val">100%</span>
        </label>
        <input type="range" id="logo-scale" min="50" max="200" value="100" oninput="updateLogoScale(this.value)" />
      </div>

      <div class="offset-row">
        <div class="control-row half">
          <label class="control-label">X</label>
          <input type="range" id="logo-offset-x" min="-100" max="100" value="0" oninput="updateLogoOffset()" />
        </div>
        <div class="control-row half">
          <label class="control-label">Y</label>
          <input type="range" id="logo-offset-y" min="-100" max="100" value="0" oninput="updateLogoOffset()" />
        </div>
      </div>
    </div>
  </div>

  <!-- Background Mode Controls -->
  <div class="controls-section" id="bg-controls" style="display:none;">
    <div class="control-row">
      <label class="control-label">{t("image.bg_color")}</label>
      <input type="color" id="bg-color" value="#ffffff" onchange="updateBgColor(this.value)" />
    </div>

    <div class="control-row">
      <label class="control-label">
        {t("image.opacity")}
        <span class="control-value" id="bg-opacity-val">100%</span>
      </label>
      <input
        type="range"
        id="bg-opacity"
        min="10"
        max="100"
        value="100"
        oninput="updateBgOpacity(this.value)"
      />
    </div>

    <div class="control-group">
      <label class="control-label">{t("image.fit")}</label>
      <div class="fit-buttons">
        <button
          class="fit-btn active"
          data-fit="cover"
          onclick="setBgFit('cover')">{t("image.cover")}</button
        >
        <button
          class="fit-btn"
          data-fit="contain"
          onclick="setBgFit('contain')">{t("image.contain")}</button
        >
        <button class="fit-btn" data-fit="fill" onclick="setBgFit('fill')"
          >{t("image.fill")}</button
        >
      </div>
    </div>

    <!-- Transform Controls -->
    <div class="transform-section">
      <label class="control-label section-title"
        >{t("image.transform")}</label
      >

      <div class="control-row">
        <label class="control-label">
          {t("image.rotation")}
          <span class="control-value" id="bg-rotation-val">0°</span>
        </label>
        <input
          type="range"
          id="bg-rotation"
          min="-180"
          max="180"
          value="0"
          oninput="updateBgRotation(this.value)"
        />
      </div>

      <div class="control-row">
        <label class="control-label">
          {t("image.scale")}
          <span class="control-value" id="bg-scale-val">100%</span>
        </label>
        <input
          type="range"
          id="bg-scale"
          min="50"
          max="200"
          value="100"
          oninput="updateBgScale(this.value)"
        />
      </div>

      <div class="offset-row">
        <div class="control-row half">
          <label class="control-label">X</label>
          <input
            type="range"
            id="bg-offset-x"
            min="-100"
            max="100"
            value="0"
            oninput="updateBgOffset()"
          />
        </div>
        <div class="control-row half">
          <label class="control-label">Y</label>
          <input
            type="range"
            id="bg-offset-y"
            min="-100"
            max="100"
            value="0"
            oninput="updateBgOffset()"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Paper Mode Controls -->
  <div class="controls-section" id="paper-controls" style="display:none;">
    <div class="control-row">
      <label class="control-label">
        {t("image.opacity")}
        <span class="control-value" id="paper-opacity-val">100%</span>
      </label>
      <input
        type="range"
        id="paper-opacity"
        min="0"
        max="100"
        value="100"
        oninput="updatePaperOpacity(this.value)"
      />
    </div>

    <div class="control-group">
      <label class="control-label">{t("image.fit")}</label>
      <div class="fit-buttons">
        <button class="fit-btn active" data-fit="cover" onclick="setPaperFit('cover')">{t("image.cover")}</button>
        <button class="fit-btn" data-fit="contain" onclick="setPaperFit('contain')">{t("image.contain")}</button>
        <button class="fit-btn" data-fit="fill" onclick="setPaperFit('fill')">{t("image.fill")}</button>
      </div>
    </div>

    <div class="transform-section">
      <label class="control-label section-title">{t("image.transform")}</label>

      <div class="control-row">
        <label class="control-label">
          {t("image.rotation")}
          <span class="control-value" id="paper-rotation-val">0°</span>
        </label>
        <input type="range" id="paper-rotation" min="-180" max="180" value="0" oninput="updatePaperRotation(this.value)" />
      </div>

      <div class="control-row">
        <label class="control-label">
          {t("image.scale")}
          <span class="control-value" id="paper-scale-val">100%</span>
        </label>
        <input type="range" id="paper-scale" min="50" max="200" value="100" oninput="updatePaperScale(this.value)" />
      </div>

      <div class="offset-row">
        <div class="control-row half">
          <label class="control-label">X</label>
          <input type="range" id="paper-offset-x" min="-100" max="100" value="0" oninput="updatePaperOffset()" />
        </div>
        <div class="control-row half">
          <label class="control-label">Y</label>
          <input type="range" id="paper-offset-y" min="-100" max="100" value="0" oninput="updatePaperOffset()" />
        </div>
      </div>
    </div>
  </div>

  <!-- Ink Mode Controls -->
  <div class="controls-section" id="ink-controls" style="display:none;">
    <div class="control-row">
      <label class="control-label">
        {t("image.opacity")}
        <span class="control-value" id="ink-opacity-val">100%</span>
      </label>
      <input
        type="range"
        id="ink-opacity"
        min="0"
        max="100"
        value="100"
        oninput="updateInkOpacity(this.value)"
      />
    </div>

    <div class="control-group">
      <label class="control-label">{t("image.fit")}</label>
      <div class="fit-buttons">
        <button class="fit-btn active" data-fit="cover" onclick="setInkFit('cover')">{t("image.cover")}</button>
        <button class="fit-btn" data-fit="contain" onclick="setInkFit('contain')">{t("image.contain")}</button>
        <button class="fit-btn" data-fit="fill" onclick="setInkFit('fill')">{t("image.fill")}</button>
      </div>
    </div>

    <div class="transform-section">
      <label class="control-label section-title">{t("image.transform")}</label>

      <div class="control-row">
        <label class="control-label">
          {t("image.rotation")}
          <span class="control-value" id="ink-rotation-val">0°</span>
        </label>
        <input type="range" id="ink-rotation" min="-180" max="180" value="0" oninput="updateInkRotation(this.value)" />
      </div>

      <div class="control-row">
        <label class="control-label">
          {t("image.scale")}
          <span class="control-value" id="ink-scale-val">100%</span>
        </label>
        <input type="range" id="ink-scale" min="50" max="200" value="100" oninput="updateInkScale(this.value)" />
      </div>

      <div class="offset-row">
        <div class="control-row half">
          <label class="control-label">X</label>
          <input type="range" id="ink-offset-x" min="-100" max="100" value="0" oninput="updateInkOffset()" />
        </div>
        <div class="control-row half">
          <label class="control-label">Y</label>
          <input type="range" id="ink-offset-y" min="-100" max="100" value="0" oninput="updateInkOffset()" />
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  let currentMode = "bg";

  function getConfig() {
    return (window as any).state?.config;
  }

  function getLayers() {
    return (window as any).qrLayers?.get?.() || (window as any).state?.config?.layers;
  }

  function getCurrentImageForMode(mode: "bg" | "paper" | "ink" | "logo"): string | undefined {
    const layers = getLayers();
    if (layers) {
      if (mode === "bg") return layers.bg?.image;
      if (mode === "paper") return layers.paper?.image;
      if (mode === "ink") return layers.ink?.image;
      return layers.logo?.image;
    }
    const cfg = getConfig();
    if (!cfg) return undefined;
    if (mode === "bg") return cfg.artImage;
    return cfg.logo;
  }

  function getCurrentImage(): string | undefined {
    return getCurrentImageForMode(currentMode as any);
  }

  // Public hook so other components (like the panel system) can force a UI sync
  // after state changes (e.g. presets injecting a logo) or when the panel is opened.
  window.refreshImagePanelUI = function () {
    // Ensure mode button styles match currentMode
    document
      .getElementById("mode-bg")
      ?.classList.toggle("active", currentMode === "bg");
    document
      .getElementById("mode-paper")
      ?.classList.toggle("active", currentMode === "paper");
    document
      .getElementById("mode-ink")
      ?.classList.toggle("active", currentMode === "ink");
    document
      .getElementById("mode-logo")
      ?.classList.toggle("active", currentMode === "logo");

    updateModeThumbs();
    updateImageUI(!!getCurrentImage());
  };

  function updateModeThumbs() {
    const layers = getLayers();

    const slots = [
      {
        id: "bg",
        image: layers?.bg?.image,
        enabled: layers?.bg?.enabled ?? true,
      },
      {
        id: "paper",
        image: layers?.paper?.image,
        enabled: layers?.paper?.enabled ?? true,
      },
      {
        id: "ink",
        image: layers?.ink?.image,
        enabled: layers?.ink?.enabled ?? true,
      },
      {
        id: "logo",
        image: layers?.logo?.image,
        enabled: layers?.logo?.enabled ?? true,
      },
    ];

    for (const s of slots) {
      const thumb = document.getElementById(`thumb-${s.id}`) as HTMLElement | null;
      const clear = document.getElementById(`clear-${s.id}`) as HTMLButtonElement | null;
      if (!thumb) continue;
      const has = typeof s.image === "string" && s.image.length > 0;
      thumb.classList.toggle("has-image", has);
      thumb.classList.toggle("disabled", has && !s.enabled);
      thumb.style.backgroundImage = has ? `url("${s.image}")` : "";
      if (clear) clear.style.display = has ? "flex" : "none";
    }
  }

  window.clearImageSlot = function (event: Event, slot: "bg" | "paper" | "ink" | "logo") {
    event.preventDefault();
    event.stopPropagation();

    const cfg = getConfig();
    if (!cfg) return;

    const layers = getLayers();
    if (!layers) return;

    if (slot === "logo") {
      if ((window as any).qrLayers?.setLogo) (window as any).qrLayers.setLogo(undefined);
      else cfg.logo = undefined;
    } else if (slot === "bg") {
      if ((window as any).qrLayers?.setBg) (window as any).qrLayers.setBg({ image: undefined });
      else {
        layers.bg.image = undefined;
      }
    } else if (slot === "paper") {
      if ((window as any).qrLayers?.setPaper) (window as any).qrLayers.setPaper({ image: undefined });
      else layers.paper.image = undefined;
    } else if (slot === "ink") {
      if ((window as any).qrLayers?.setInk) (window as any).qrLayers.setInk({ image: undefined });
      else layers.ink.image = undefined;
    }

    updateModeThumbs();
    updateImageUI(!!getCurrentImage());
    (window as any).updateQR?.();
  };

  function tryInitImagePanelUI() {
    // state/config and/or qrLayers might be attached after inline scripts run
    const cfg = getConfig();
    const layers = getLayers();
    if (!cfg || !layers?.bg || !layers?.paper || !layers?.ink || !layers?.logo) {
      setTimeout(tryInitImagePanelUI, 50);
      return;
    }
    initDropArea();
    window.refreshImagePanelUI?.();
  }

  // Best-effort initial sync
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", tryInitImagePanelUI);
  } else {
    tryInitImagePanelUI();
  }
  // Also re-sync after Astro view transitions
  document.addEventListener("astro:page-load", tryInitImagePanelUI);

  function syncBgControlsFromLayers() {
    const layers = getLayers();
    if (!layers?.bg) return;

    const color = document.getElementById("bg-color") as HTMLInputElement | null;
    if (color) color.value = layers.bg.color || "#ffffff";

    const op = document.getElementById("bg-opacity") as HTMLInputElement | null;
    const opVal = document.getElementById("bg-opacity-val");
    if (op) {
      const pct = Math.round(((layers.bg.opacity ?? 1) * 100));
      op.value = String(pct);
      if (opVal) opVal.textContent = `${pct}%`;
    }

    const rot = document.getElementById("bg-rotation") as HTMLInputElement | null;
    const rotVal = document.getElementById("bg-rotation-val");
    if (rot) {
      const deg = Math.round(layers.bg.rotation ?? 0);
      rot.value = String(deg);
      if (rotVal) rotVal.textContent = `${deg}°`;
    }

    const scale = document.getElementById("bg-scale") as HTMLInputElement | null;
    const scaleVal = document.getElementById("bg-scale-val");
    if (scale) {
      const pct = Math.round(((layers.bg.scale ?? 1) * 100));
      scale.value = String(pct);
      if (scaleVal) scaleVal.textContent = `${pct}%`;
    }

    const ox = document.getElementById("bg-offset-x") as HTMLInputElement | null;
    const oy = document.getElementById("bg-offset-y") as HTMLInputElement | null;
    if (ox) ox.value = String(Math.round(((layers.bg.offsetX ?? 0) * 100)));
    if (oy) oy.value = String(Math.round(((layers.bg.offsetY ?? 0) * 100)));

    document.querySelectorAll("#bg-controls .fit-btn").forEach((b) => b.classList.remove("active"));
    const fit = layers.bg.fit || "cover";
    document.querySelector(`#bg-controls [data-fit="${fit}"]`)?.classList.add("active");
  }

  function syncPaperControlsFromLayers() {
    const layers = getLayers();
    if (!layers?.paper) return;

    const op = document.getElementById("paper-opacity") as HTMLInputElement | null;
    const opVal = document.getElementById("paper-opacity-val");
    if (op) {
      const pct = Math.round(((layers.paper.opacity ?? 1) * 100));
      op.value = String(pct);
      if (opVal) opVal.textContent = `${pct}%`;
    }

    const rot = document.getElementById("paper-rotation") as HTMLInputElement | null;
    const rotVal = document.getElementById("paper-rotation-val");
    if (rot) {
      const deg = Math.round(layers.paper.rotation ?? 0);
      rot.value = String(deg);
      if (rotVal) rotVal.textContent = `${deg}°`;
    }

    const scale = document.getElementById("paper-scale") as HTMLInputElement | null;
    const scaleVal = document.getElementById("paper-scale-val");
    if (scale) {
      const pct = Math.round(((layers.paper.scale ?? 1) * 100));
      scale.value = String(pct);
      if (scaleVal) scaleVal.textContent = `${pct}%`;
    }

    const ox = document.getElementById("paper-offset-x") as HTMLInputElement | null;
    const oy = document.getElementById("paper-offset-y") as HTMLInputElement | null;
    if (ox) ox.value = String(Math.round(((layers.paper.offsetX ?? 0) * 100)));
    if (oy) oy.value = String(Math.round(((layers.paper.offsetY ?? 0) * 100)));

    document.querySelectorAll("#paper-controls .fit-btn").forEach((b) => b.classList.remove("active"));
    const fit = layers.paper.fit || "cover";
    document.querySelector(`#paper-controls [data-fit="${fit}"]`)?.classList.add("active");
  }

  function syncInkControlsFromLayers() {
    const layers = getLayers();
    if (!layers?.ink) return;

    const op = document.getElementById("ink-opacity") as HTMLInputElement | null;
    const opVal = document.getElementById("ink-opacity-val");
    if (op) {
      const pct = Math.round(((layers.ink.opacity ?? 1) * 100));
      op.value = String(pct);
      if (opVal) opVal.textContent = `${pct}%`;
    }

    const rot = document.getElementById("ink-rotation") as HTMLInputElement | null;
    const rotVal = document.getElementById("ink-rotation-val");
    if (rot) {
      const deg = Math.round(layers.ink.rotation ?? 0);
      rot.value = String(deg);
      if (rotVal) rotVal.textContent = `${deg}°`;
    }

    const scale = document.getElementById("ink-scale") as HTMLInputElement | null;
    const scaleVal = document.getElementById("ink-scale-val");
    if (scale) {
      const pct = Math.round(((layers.ink.scale ?? 1) * 100));
      scale.value = String(pct);
      if (scaleVal) scaleVal.textContent = `${pct}%`;
    }

    const ox = document.getElementById("ink-offset-x") as HTMLInputElement | null;
    const oy = document.getElementById("ink-offset-y") as HTMLInputElement | null;
    if (ox) ox.value = String(Math.round(((layers.ink.offsetX ?? 0) * 100)));
    if (oy) oy.value = String(Math.round(((layers.ink.offsetY ?? 0) * 100)));

    document.querySelectorAll("#ink-controls .fit-btn").forEach((b) => b.classList.remove("active"));
    const fit = layers.ink.fit || "cover";
    document.querySelector(`#ink-controls [data-fit="${fit}"]`)?.classList.add("active");
  }

  function syncLogoControlsFromState() {
    const cfg = getConfig();
    const layers = getLayers();
    if (!cfg || !layers?.logo) return;

    const op = document.getElementById("logo-opacity") as HTMLInputElement | null;
    const opVal = document.getElementById("logo-opacity-val");
    if (op) {
      const pct = Math.round(((layers.logo.opacity ?? 1) * 100));
      op.value = String(pct);
      if (opVal) opVal.textContent = `${pct}%`;
    }

    const rot = document.getElementById("logo-rotation") as HTMLInputElement | null;
    const rotVal = document.getElementById("logo-rotation-val");
    if (rot) {
      const deg = Math.round(cfg.logoRotation ?? 0);
      rot.value = String(deg);
      if (rotVal) rotVal.textContent = `${deg}°`;
    }

    const scale = document.getElementById("logo-scale") as HTMLInputElement | null;
    const scaleVal = document.getElementById("logo-scale-val");
    if (scale) {
      const pct = Math.round(((cfg.logoScale ?? 1) * 100));
      scale.value = String(pct);
      if (scaleVal) scaleVal.textContent = `${pct}%`;
    }

    const ox = document.getElementById("logo-offset-x") as HTMLInputElement | null;
    const oy = document.getElementById("logo-offset-y") as HTMLInputElement | null;
    if (ox) ox.value = String(Math.round(((cfg.logoOffsetX ?? 0) * 100)));
    if (oy) oy.value = String(Math.round(((cfg.logoOffsetY ?? 0) * 100)));

    document.querySelectorAll("#logo-controls [data-logo-fit]").forEach((b) => b.classList.remove("active"));
    const fit = layers.logo.fit || cfg.logoFit || "contain";
    document.querySelector(`#logo-controls [data-logo-fit="${fit}"]`)?.classList.add("active");

    const bgEnabled = cfg.logoBgEnabled !== false;
    const bgToggle = document.getElementById("logo-bg-toggle") as HTMLInputElement | null;
    if (bgToggle) bgToggle.checked = bgEnabled;

    const bgColor = document.getElementById("logo-bg-color") as HTMLInputElement | null;
    if (bgColor) bgColor.value = normalizeLogoBgColor(cfg.logoBgColor);

    const shape = cfg.logoBgShape || "rounded";
    document.querySelectorAll("#logo-shape-group [data-shape]").forEach((b) => b.classList.remove("active"));
    document.querySelector(`#logo-shape-group [data-shape="${shape}"]`)?.classList.add("active");
    syncLogoBgControlVisibility(bgEnabled, shape);
  }

  function normalizeLogoBgColor(value: unknown): string {
    if (typeof value === "string" && /^#[0-9a-fA-F]{6}$/.test(value)) {
      return value;
    }
    if (Array.isArray(value) && value.length >= 3) {
      const max = value.some((v) => typeof v === "number" && v > 1) ? 255 : 1;
      const parts = value.slice(0, 3).map((v) => {
        const n = typeof v === "number" && Number.isFinite(v) ? v : max;
        return Math.round(Math.max(0, Math.min(255, (n / max) * 255)))
          .toString(16)
          .padStart(2, "0");
      });
      return `#${parts.join("")}`;
    }
    return "#ffffff";
  }

  function syncLogoBgControlVisibility(enabled: boolean, shape?: string) {
    const shapeGroup = document.getElementById("logo-shape-group");
    const colorRow = document.getElementById("logo-bg-color-row");
    const radiusRow = document.getElementById("logo-radius-row");
    const paddingRow = document
      .getElementById("logo-padding")
      ?.closest(".control-row") as HTMLElement | null;
    const resolvedShape = shape || getConfig()?.logoBgShape || "rounded";

    if (shapeGroup) shapeGroup.style.display = enabled ? "flex" : "none";
    if (colorRow) colorRow.style.display = enabled ? "flex" : "none";
    if (paddingRow) paddingRow.style.display = enabled ? "flex" : "none";
    if (radiusRow) radiusRow.style.display = enabled && resolvedShape === "rounded" ? "flex" : "none";
  }

  window.setImageMode = function (mode: "bg" | "paper" | "ink" | "logo") {
    currentMode = mode;

    // Update button states
    document.getElementById("mode-bg")?.classList.toggle("active", mode === "bg");
    document.getElementById("mode-paper")?.classList.toggle("active", mode === "paper");
    document.getElementById("mode-ink")?.classList.toggle("active", mode === "ink");
    document.getElementById("mode-logo")?.classList.toggle("active", mode === "logo");

    // Show/hide mode-specific controls
    const logoControls = document.getElementById("logo-controls");
    const bgControls = document.getElementById("bg-controls");
    const paperControls = document.getElementById("paper-controls");
    const inkControls = document.getElementById("ink-controls");

    if (mode === "logo") {
      if (logoControls) logoControls.style.display = "flex";
      if (bgControls) bgControls.style.display = "none";
      if (paperControls) paperControls.style.display = "none";
      if (inkControls) inkControls.style.display = "none";
      syncLogoControlsFromState();
    } else if (mode === "bg") {
      if (logoControls) logoControls.style.display = "none";
      if (bgControls) bgControls.style.display = "flex";
      if (paperControls) paperControls.style.display = "none";
      if (inkControls) inkControls.style.display = "none";
      syncBgControlsFromLayers();
    } else if (mode === "paper") {
      if (logoControls) logoControls.style.display = "none";
      if (bgControls) bgControls.style.display = "none";
      if (paperControls) paperControls.style.display = "flex";
      if (inkControls) inkControls.style.display = "none";
      syncPaperControlsFromLayers();
    } else if (mode === "ink") {
      if (logoControls) logoControls.style.display = "none";
      if (bgControls) bgControls.style.display = "none";
      if (paperControls) paperControls.style.display = "none";
      if (inkControls) inkControls.style.display = "flex";
      syncInkControlsFromLayers();
    } else {
      if (logoControls) logoControls.style.display = "none";
      if (bgControls) bgControls.style.display = "none";
      if (paperControls) paperControls.style.display = "none";
      if (inkControls) inkControls.style.display = "none";
    }

    updateModeThumbs();
    updateImageUI(!!getCurrentImageForMode(mode));
    (window as any).updateQR?.();
  };

  window.handleImageUpload = async function (event: Event) {
    const input = event.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;

    const modeAtPick = currentMode;
    const reader = new FileReader();
    reader.onload = (e) => {
      const dataUrl = e.target?.result as string;

      const cfg = getConfig();
      if (!cfg) return;
      const layers = getLayers();
      if (!layers) return;

      // Store ONLY in the active slot
      if (modeAtPick === "logo") {
        if ((window as any).qrLayers?.setLogo) (window as any).qrLayers.setLogo(dataUrl);
        else cfg.logo = dataUrl;
        cfg.logoColor = "original";
        // Do not disable background art when uploading a logo.

        // Set sensible defaults only if unset
        if (cfg.logoSize === undefined || cfg.logoSize === null)
          cfg.logoSize = 0.2;
        if (cfg.logoBgEnabled === undefined || cfg.logoBgEnabled === null)
          cfg.logoBgEnabled = true;
        if (!cfg.logoFit) cfg.logoFit = "contain";
        if (layers.logo && !layers.logo.fit) layers.logo.fit = "contain";
      } else if (modeAtPick === "bg") {
        if ((window as any).qrLayers?.setBg) {
          (window as any).qrLayers.setBg({ image: dataUrl, enabled: true });
        } else {
          layers.bg.image = dataUrl;
          layers.bg.enabled = true;
        }
        syncBgControlsFromLayers();
      } else if (modeAtPick === "paper") {
        if ((window as any).qrLayers?.setPaper) (window as any).qrLayers.setPaper({ image: dataUrl, enabled: true });
        else {
          layers.paper.image = dataUrl;
          layers.paper.enabled = true;
        }
      } else if (modeAtPick === "ink") {
        if ((window as any).qrLayers?.setInk) (window as any).qrLayers.setInk({ image: dataUrl, enabled: true });
        else {
          layers.ink.image = dataUrl;
          layers.ink.enabled = true;
        }
      }

      updateModeThumbs();
      updateImageUI(true);
      (window as any).updateQR?.();

      // Allow selecting the same file again
      input.value = "";
    };
    reader.readAsDataURL(file);
  };

  window.removeImage = function () {
    window.clearImageSlot?.(new Event("remove"), currentMode);
  };

  function updateImageUI(hasImage: boolean) {
    const placeholder = document.getElementById("image-placeholder");
    const preview = document.getElementById("image-preview");
    const logoControls = document.getElementById("logo-controls");
    const bgControls = document.getElementById("bg-controls");
    const paperControls = document.getElementById("paper-controls");
    const inkControls = document.getElementById("ink-controls");
    const img = document.getElementById("preview-img") as HTMLImageElement;
    const area = document.getElementById("image-upload-area");

    if (hasImage) {
      if (placeholder) placeholder.style.display = "none";
      if (preview) preview.style.display = "flex";
      if (area) area.classList.add("has-image");
      if (img) img.src = getCurrentImage() || "";

      // Show controls based on mode
      if (currentMode === "logo") {
        if (logoControls) logoControls.style.display = "flex";
        if (bgControls) bgControls.style.display = "none";
        if (paperControls) paperControls.style.display = "none";
        if (inkControls) inkControls.style.display = "none";
        syncLogoControlsFromState();
      } else if (currentMode === "bg") {
        if (logoControls) logoControls.style.display = "none";
        if (bgControls) bgControls.style.display = "flex";
        if (paperControls) paperControls.style.display = "none";
        if (inkControls) inkControls.style.display = "none";
        syncBgControlsFromLayers();
      } else if (currentMode === "paper") {
        if (logoControls) logoControls.style.display = "none";
        if (bgControls) bgControls.style.display = "none";
        if (paperControls) paperControls.style.display = "flex";
        if (inkControls) inkControls.style.display = "none";
        syncPaperControlsFromLayers();
      } else if (currentMode === "ink") {
        if (logoControls) logoControls.style.display = "none";
        if (bgControls) bgControls.style.display = "none";
        if (paperControls) paperControls.style.display = "none";
        if (inkControls) inkControls.style.display = "flex";
        syncInkControlsFromLayers();
      } else {
        if (logoControls) logoControls.style.display = "none";
        if (bgControls) bgControls.style.display = "none";
        if (paperControls) paperControls.style.display = "none";
        if (inkControls) inkControls.style.display = "none";
      }
    } else {
      if (placeholder) placeholder.style.display = "flex";
      if (preview) preview.style.display = "none";
      if (area) area.classList.remove("has-image");
      if (logoControls) logoControls.style.display = currentMode === "logo" ? "flex" : "none";
      if (bgControls) bgControls.style.display = currentMode === "bg" ? "flex" : "none";
      if (paperControls) paperControls.style.display = currentMode === "paper" ? "flex" : "none";
      if (inkControls) inkControls.style.display = currentMode === "ink" ? "flex" : "none";
      if (currentMode === "logo") syncLogoControlsFromState();
      if (currentMode === "bg") syncBgControlsFromLayers();
      if (currentMode === "paper") syncPaperControlsFromLayers();
      if (currentMode === "ink") syncInkControlsFromLayers();
    }
  }

  // Logo Controls
  window.updateLogoSize = function (value: number) {
    const size = value / 100;
    document.getElementById("logo-size-val")!.textContent = `${value}%`;
    if ((window as any).state?.config) {
      (window as any).state.config.logoSize = size;
      (window as any).updateQR?.();
    }
  };

  window.updateLogoBg = function (enabled: boolean) {
    if ((window as any).state?.config) {
      (window as any).state.config.logoBgEnabled = enabled;
      if (enabled && !(window as any).state.config.logoBgColor) {
        (window as any).state.config.logoBgColor = "#ffffff";
      }
      syncLogoBgControlVisibility(enabled);
      (window as any).updateQR?.();
    }
  };

  window.updateLogoBgColor = function (value: string) {
    const cfg = getConfig();
    if (!cfg) return;
    cfg.logoBgColor = value || "#ffffff";
    cfg.logoBgEnabled = true;
    const bgToggle = document.getElementById("logo-bg-toggle") as HTMLInputElement | null;
    if (bgToggle) bgToggle.checked = true;
    syncLogoBgControlVisibility(true);
    (window as any).updateQR?.();
  };

  window.setLogoShape = function (shape: string) {
    document
      .querySelectorAll("[data-shape]")
      .forEach((b) => b.classList.remove("active"));
    document.querySelector(`[data-shape="${shape}"]`)?.classList.add("active");

    if ((window as any).state?.config) {
      (window as any).state.config.logoBgShape = shape;
      syncLogoBgControlVisibility((window as any).state.config.logoBgEnabled !== false, shape);
      (window as any).updateQR?.();
    }
  };

  window.updateLogoRadius = function (value: number) {
    document.getElementById("logo-radius-val")!.textContent = `${value}`;
    if ((window as any).state?.config) {
      (window as any).state.config.logoCornerRadius = parseInt(value as any);
      (window as any).updateQR?.();
    }
  };

  window.updateLogoPadding = function (value: number) {
    document.getElementById("logo-padding-val")!.textContent = `${value}`;
    if ((window as any).state?.config) {
      (window as any).state.config.logoPadding = parseInt(value as any);
      (window as any).updateQR?.();
    }
  };

  window.setLogoFit = function (fit: string) {
    document.querySelectorAll("#logo-controls [data-logo-fit]").forEach((b) => b.classList.remove("active"));
    document.querySelector(`#logo-controls [data-logo-fit="${fit}"]`)?.classList.add("active");
    const layers = getLayers();
    const cfg = getConfig();
    if (layers?.logo) layers.logo.fit = fit;
    if (cfg) cfg.logoFit = fit;
    (window as any).updateQR?.();
  };

  function initDropArea() {
    const area = document.getElementById("image-upload-area") as HTMLElement | null;
    const input = document.getElementById("image-input") as HTMLInputElement | null;
    if (!area || !input) return;
    if ((area as any).dataset?.inited === "1") return;
    (area as any).dataset.inited = "1";

    area.addEventListener("dragover", (e) => {
      e.preventDefault();
      area.classList.add("dragover");
    });

    area.addEventListener("dragleave", () => {
      area.classList.remove("dragover");
    });

    area.addEventListener("drop", (e) => {
      e.preventDefault();
      area.classList.remove("dragover");

      const file = e.dataTransfer?.files?.[0];
      if (!file?.type?.startsWith("image/")) return;

      const modeAtDrop = currentMode;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const dataUrl = ev.target?.result as string;
        if (!dataUrl) return;

        // Reuse the upload code path by assigning to input handler with captured mode.
        const cfg = getConfig();
        const layers = getLayers();
        if (!cfg || !layers) return;

        if (modeAtDrop === "logo") {
          if ((window as any).qrLayers?.setLogo) (window as any).qrLayers.setLogo(dataUrl);
          else cfg.logo = dataUrl;
          cfg.logoColor = "original";
          if (!cfg.logoFit) cfg.logoFit = "contain";
          if (layers.logo && !layers.logo.fit) layers.logo.fit = "contain";
        } else if (modeAtDrop === "bg") {
          if ((window as any).qrLayers?.setBg) (window as any).qrLayers.setBg({ image: dataUrl, enabled: true });
          else {
            layers.bg.image = dataUrl;
            layers.bg.enabled = true;
          }
          syncBgControlsFromLayers();
        } else if (modeAtDrop === "paper") {
          if ((window as any).qrLayers?.setPaper) (window as any).qrLayers.setPaper({ image: dataUrl, enabled: true });
          else {
            layers.paper.image = dataUrl;
            layers.paper.enabled = true;
          }
        } else if (modeAtDrop === "ink") {
          if ((window as any).qrLayers?.setInk) (window as any).qrLayers.setInk({ image: dataUrl, enabled: true });
          else {
            layers.ink.image = dataUrl;
            layers.ink.enabled = true;
          }
        }

        updateModeThumbs();
        updateImageUI(true);
        (window as any).updateQR?.();

        // Allow selecting the same file again
        input.value = "";
      };
      reader.readAsDataURL(file);
    });
  }

  // BG Controls
  window.updateBgColor = function (value: string) {
    const layers = getLayers();
    if (!layers) return;
    if ((window as any).qrLayers?.setBg) (window as any).qrLayers.setBg({ color: value });
    else layers.bg.color = value;
    (window as any).updateQR?.();
  };

  window.updateBgOpacity = function (value: number) {
    document.getElementById("bg-opacity-val")!.textContent = `${value}%`;
    const layers = getLayers();
    if (!layers) return;
    if ((window as any).qrLayers?.setBg) (window as any).qrLayers.setBg({ opacity: value / 100 });
    else layers.bg.opacity = value / 100;
    (window as any).updateQR?.();
  };

  window.setBgFit = function (fit: string) {
    document.querySelectorAll("#bg-controls .fit-btn").forEach((b) => b.classList.remove("active"));
    document.querySelector(`#bg-controls [data-fit="${fit}"]`)?.classList.add("active");
    const layers = getLayers();
    if (!layers) return;
    if ((window as any).qrLayers?.setBg) (window as any).qrLayers.setBg({ fit });
    else layers.bg.fit = fit;
    (window as any).updateQR?.();
  };

  window.updateBgRotation = function (value: number) {
    document.getElementById("bg-rotation-val")!.textContent = `${value}°`;
    const layers = getLayers();
    if (!layers) return;
    if ((window as any).qrLayers?.setBg) (window as any).qrLayers.setBg({ rotation: parseFloat(value as any) });
    else layers.bg.rotation = parseFloat(value as any);
    (window as any).updateQR?.();
  };

  window.updateBgScale = function (value: number) {
    document.getElementById("bg-scale-val")!.textContent = `${value}%`;
    const layers = getLayers();
    if (!layers) return;
    if ((window as any).qrLayers?.setBg) (window as any).qrLayers.setBg({ scale: value / 100 });
    else layers.bg.scale = value / 100;
    (window as any).updateQR?.();
  };

  window.updateBgOffset = function () {
    const x = (document.getElementById("bg-offset-x") as HTMLInputElement)?.value || 0;
    const y = (document.getElementById("bg-offset-y") as HTMLInputElement)?.value || 0;
    const layers = getLayers();
    if (!layers) return;
    const patch = { offsetX: parseFloat(x as any) / 100, offsetY: parseFloat(y as any) / 100 };
    if ((window as any).qrLayers?.setBg) (window as any).qrLayers.setBg(patch);
    else Object.assign(layers.bg, patch);
    (window as any).updateQR?.();
  };

  // Paper Controls
  window.updatePaperOpacity = function (value: number) {
    document.getElementById("paper-opacity-val")!.textContent = `${value}%`;
    (window as any).qrLayers?.setLayerOpacity?.("paper", Math.max(0, Math.min(1, value / 100)));
  };

  window.setPaperFit = function (fit: string) {
    document.querySelectorAll("#paper-controls .fit-btn").forEach((b) => b.classList.remove("active"));
    document.querySelector(`#paper-controls [data-fit="${fit}"]`)?.classList.add("active");
    const layers = getLayers();
    if (!layers) return;
    if ((window as any).qrLayers?.setPaper) (window as any).qrLayers.setPaper({ fit });
    else layers.paper.fit = fit;
    (window as any).updateQR?.();
  };

  window.updatePaperRotation = function (value: number) {
    document.getElementById("paper-rotation-val")!.textContent = `${value}°`;
    const layers = getLayers();
    if (!layers) return;
    const deg = parseFloat(value as any);
    if ((window as any).qrLayers?.setPaper) (window as any).qrLayers.setPaper({ rotation: deg });
    else layers.paper.rotation = deg;
    (window as any).updateQR?.();
  };

  window.updatePaperScale = function (value: number) {
    document.getElementById("paper-scale-val")!.textContent = `${value}%`;
    const layers = getLayers();
    if (!layers) return;
    const s = (value as any) / 100;
    if ((window as any).qrLayers?.setPaper) (window as any).qrLayers.setPaper({ scale: s });
    else layers.paper.scale = s;
    (window as any).updateQR?.();
  };

  window.updatePaperOffset = function () {
    const x = (document.getElementById("paper-offset-x") as HTMLInputElement)?.value || 0;
    const y = (document.getElementById("paper-offset-y") as HTMLInputElement)?.value || 0;
    const layers = getLayers();
    if (!layers) return;
    const patch = { offsetX: parseFloat(x as any) / 100, offsetY: parseFloat(y as any) / 100 };
    if ((window as any).qrLayers?.setPaper) (window as any).qrLayers.setPaper(patch);
    else Object.assign(layers.paper, patch);
    (window as any).updateQR?.();
  };

  // Ink Controls
  window.updateInkOpacity = function (value: number) {
    document.getElementById("ink-opacity-val")!.textContent = `${value}%`;
    (window as any).qrLayers?.setLayerOpacity?.("ink", Math.max(0, Math.min(1, value / 100)));
  };

  window.setInkFit = function (fit: string) {
    document.querySelectorAll("#ink-controls .fit-btn").forEach((b) => b.classList.remove("active"));
    document.querySelector(`#ink-controls [data-fit="${fit}"]`)?.classList.add("active");
    const layers = getLayers();
    if (!layers) return;
    if ((window as any).qrLayers?.setInk) (window as any).qrLayers.setInk({ fit });
    else layers.ink.fit = fit;
    (window as any).updateQR?.();
  };

  window.updateInkRotation = function (value: number) {
    document.getElementById("ink-rotation-val")!.textContent = `${value}°`;
    const layers = getLayers();
    if (!layers) return;
    const deg = parseFloat(value as any);
    if ((window as any).qrLayers?.setInk) (window as any).qrLayers.setInk({ rotation: deg });
    else layers.ink.rotation = deg;
    (window as any).updateQR?.();
  };

  window.updateInkScale = function (value: number) {
    document.getElementById("ink-scale-val")!.textContent = `${value}%`;
    const layers = getLayers();
    if (!layers) return;
    const s = (value as any) / 100;
    if ((window as any).qrLayers?.setInk) (window as any).qrLayers.setInk({ scale: s });
    else layers.ink.scale = s;
    (window as any).updateQR?.();
  };

  window.updateInkOffset = function () {
    const x = (document.getElementById("ink-offset-x") as HTMLInputElement)?.value || 0;
    const y = (document.getElementById("ink-offset-y") as HTMLInputElement)?.value || 0;
    const layers = getLayers();
    if (!layers) return;
    const patch = { offsetX: parseFloat(x as any) / 100, offsetY: parseFloat(y as any) / 100 };
    if ((window as any).qrLayers?.setInk) (window as any).qrLayers.setInk(patch);
    else Object.assign(layers.ink, patch);
    (window as any).updateQR?.();
  };

  // Logo (opacity + transform)
  window.updateLogoOpacity = function (value: number) {
    document.getElementById("logo-opacity-val")!.textContent = `${value}%`;
    (window as any).qrLayers?.setLayerOpacity?.("logo", Math.max(0, Math.min(1, value / 100)));
  };

  window.updateLogoRotation = function (value: number) {
    document.getElementById("logo-rotation-val")!.textContent = `${value}°`;
    const cfg = getConfig();
    if (!cfg) return;
    cfg.logoRotation = parseFloat(value as any);
    (window as any).updateQR?.();
  };

  window.updateLogoScale = function (value: number) {
    document.getElementById("logo-scale-val")!.textContent = `${value}%`;
    const cfg = getConfig();
    if (!cfg) return;
    cfg.logoScale = (value as any) / 100;
    (window as any).updateQR?.();
  };

  window.updateLogoOffset = function () {
    const cfg = getConfig();
    if (!cfg) return;
    const x = (document.getElementById("logo-offset-x") as HTMLInputElement)?.value || 0;
    const y = (document.getElementById("logo-offset-y") as HTMLInputElement)?.value || 0;
    cfg.logoOffsetX = parseFloat(x as any) / 100;
    cfg.logoOffsetY = parseFloat(y as any) / 100;
    (window as any).updateQR?.();
  };

</script>

<style>
  .image-panel-content {
    display: flex;
    flex-direction: column;
    gap: 16px;

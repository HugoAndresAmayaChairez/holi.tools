---
import { getCollection } from "astro:content";
import BaseLayout from "@holi/ui/layouts/BaseLayout.astro";
import SimpleBackground from "@holi/ui/components/SimpleBackground.astro";
import SearchExperiments from "../../components/SearchExperiments.astro";
import GlassCard from "@holi/ui/components/GlassCard.astro";
import Icon from "@holi/ui/components/Icon.astro";
import ProductCreature from "@holi/ui/components/ProductCreature.astro";
import { getLabsChangelog, labsVersion } from "../../release";
import { getLabsPrivacy } from "../../privacy";
import "../../styles/app.css";
import { getLangFromUrl, useTranslations, languages } from "../../i18n/utils";

export function getStaticPaths() {
  return languages.map((language) => ({ params: { lang: language.code } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const history = getLabsChangelog(lang);
const articles = (await getCollection("experiments"))
  .filter((entry) => entry.data.lang === lang)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const featured = articles.find((entry) => entry.data.featured) ?? articles[0];
const categories = [...new Set(articles.map((entry) => entry.data.category).filter(Boolean))] as string[];
const formatLabel = (format: string) => {
  if (format === "tutorial") return t("format_tutorial");
  if (format === "experiment") return t("format_experiment");
  if (format === "paper") return t("format_paper");
  return t("format_field_note");
};
const formats = ["tutorial", "field-note", "experiment", "paper"].map((id) => ({ id, label: formatLabel(id) }));
const readTime = (body: string) => Math.max(1, Math.round(body.split(/\s+/).filter(Boolean).length / 220));
const articleHref = (entry: (typeof articles)[number]) => {
  const collection = entry.data.format === "paper" ? "papers" : "experiments";
  return `/${lang}/${collection}/${entry.slug.replace(/-[a-z]{2}$/, "")}`;
};

const privacySummary = getLabsPrivacy(lang);
const site = Astro.site ?? new URL("https://labs.holi.tools");
const baseUrl = site.toString().replace(/\/$/, "");
const canonicalUrl = `${baseUrl}${Astro.url.pathname}`;
---

<BaseLayout
  title={t("meta_title")}
  description={t("meta_description")}
  lang={lang}
  languages={languages}
  prefixDefaultLocale={true}
  colorScheme="labs"
  productName="Holi Labs"
  productDescription={t("meta_description")}
  version={labsVersion}
  changelog={history}
  privacySummary={privacySummary}
>
  <slot name="head" slot="head">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={t("meta_title")} />
    <meta property="og:description" content={t("meta_description")} />
    <meta property="og:image" content={`${baseUrl}/og-image.svg`} />
    <meta property="og:site_name" content="Holi Labs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t("meta_title")} />
    <meta name="twitter:description" content={t("meta_description")} />
    <meta name="twitter:image" content={`${baseUrl}/og-image.svg`} />
  </slot>

  <SimpleBackground />

  <main class="labs-shell">
    <section class="hero-section">
      <ProductCreature name="axolotl" variant="mark" eager class="labs-creature" />
      <p class="hero-eyebrow">{t("hero_eyebrow")}</p>
      <h1>Holi <span>Labs</span></h1>
      <p class="hero-copy">{t("hero_slogan")}</p>
      <div class="hero-facts" aria-label={t("library_summary")}>
        <span><strong>{articles.length}</strong> {t("reads_suffix")}</span>
        <span><strong>{categories.length}</strong> {t("topics_suffix")}</span>
        <span>{t("local_reading")}</span>
      </div>
    </section>

    {featured && (
      <section class="featured-section" aria-labelledby="featured-title">
        <div class="section-heading">
          <p>{t("featured_title")}</p>
          <span>{t("start_here")}</span>
        </div>
        <a class="featured-card" href={articleHref(featured)}>
          <div class="featured-icon"><Icon name={featured.data.icon} size={30} /></div>
          <div class="featured-copy">
            <div class="article-meta">
              <span>{formatLabel(featured.data.format)}</span>
              <span>{readTime(featured.body)} {t("read_time_suffix")}</span>
              {featured.data.category && <span>{featured.data.category}</span>}
            </div>
            <h2 id="featured-title">{featured.data.title}</h2>
            <p>{featured.data.summary || featured.data.description}</p>
          </div>
          <Icon name="arrow_forward" size={22} class="featured-arrow" />
        </a>
      </section>
    )}

    <SearchExperiments categories={categories} formats={formats} />

    <section class="library-section" aria-labelledby="library-title">
      <div class="section-heading">
        <p id="library-title">{t("experiments_title")}</p>
        <span>{t("library_description")}</span>
      </div>
      <div class="article-grid">
        {articles.map((entry) => (
          <article
            class="experiment-card"
            data-title={entry.data.title}
            data-desc={entry.data.description}
            data-tags={entry.data.tags.join(" ")}
            data-category={(entry.data.category || "").toLowerCase()}
            data-format={entry.data.format}
          >
            <GlassCard
              clickable
              padding="lg"
              rounded="lg"
              accentColor={entry.data.color}
              href={articleHref(entry)}
              target="_self"
              intensity={1}
              class="article-card"
            >
              <div class="card-topline">
                <span class="card-format">{formatLabel(entry.data.format)}</span>
                <span>{readTime(entry.body)} {t("read_time_suffix")}</span>
              </div>
              <div class="card-icon"><Icon name={entry.data.icon} size={22} /></div>
              <h3>{entry.data.title}</h3>
              <p>{entry.data.description}</p>
              <div class="tag-list">
                {entry.data.tags.slice(0, 3).map((tag) => <span>#{tag}</span>)}
              </div>
            </GlassCard>
          </article>
        ))}
      </div>
    </section>

    <footer class="labs-footer">
      <a href="https://holi.tools"><Icon name="arrow_back" size={15} />{t("back_home")}</a>
      <p>{t("footer_note")}</p>
    </footer>
  </main>
</BaseLayout>

<style>
  .labs-shell { width: min(1180px, calc(100% - 32px)); min-height: 100vh; margin: 0 auto; padding: 88px 0 110px; color: var(--color-text); }
  .hero-section { position: relative; isolation: isolate; max-width: 850px; margin: 0 auto 62px; text-align: center; }
  :global(.labs-creature) { position: absolute; z-index: 0; inset-inline-end: -1rem; inset-block-start: -2rem; width: 11rem; opacity: .085; transform: rotate(7deg); }
  .hero-eyebrow,
  .section-heading p { margin: 0; color: var(--color-accent); font: 800 10px/1.3 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .16em; text-transform: uppercase; }
  .hero-section h1 { margin: 14px 0 16px; color: var(--color-text); font-size: clamp(58px, 11vw, 118px); font-weight: 900; line-height: .88; letter-spacing: -.075em; }
  .hero-section h1 span { color: var(--color-accent); }
  .hero-copy { max-width: 650px; margin: 0 auto; color: color-mix(in srgb, var(--color-text) 66%, transparent); font-size: clamp(18px, 2.4vw, 25px); line-height: 1.45; }
  .hero-facts { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-top: 25px; }
  .hero-facts span { padding: 7px 10px; color: color-mix(in srgb, var(--color-text) 66%, transparent); background: color-mix(in srgb, var(--color-text) 4%, transparent); border: 1px solid var(--color-border); border-radius: 999px; font: 650 10px/1 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .hero-facts strong { color: var(--color-text); }
  .featured-section,
  .library-section { margin: 0 auto 52px; }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 15px; }
  .section-heading span { color: color-mix(in srgb, var(--color-text) 52%, transparent); font-size: 12px; }
  .featured-card { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 23px; padding: clamp(22px, 4vw, 38px); color: inherit; background: linear-gradient(120deg, color-mix(in srgb, var(--color-accent) 11%, transparent), color-mix(in srgb, var(--color-text) 2%, transparent)); border: 1px solid color-mix(in srgb, var(--color-accent) 35%, var(--color-border)); border-radius: 23px; text-decoration: none; transition: transform .2s ease, border-color .2s ease; }
  .featured-card:hover { transform: translateY(-2px); border-color: var(--color-accent); }
  .featured-icon,
  .card-icon { display: flex; align-items: center; justify-content: center; color: var(--color-accent); background: color-mix(in srgb, var(--color-accent) 12%, transparent); border: 1px solid color-mix(in srgb, var(--color-accent) 28%, transparent); }
  .featured-icon { width: 64px; height: 64px; border-radius: 18px; }
  .featured-copy h2 { margin: 8px 0; color: var(--color-text); font-size: clamp(25px, 4vw, 42px); line-height: 1.05; letter-spacing: -.035em; }
  .featured-copy > p { max-width: 720px; margin: 0; color: color-mix(in srgb, var(--color-text) 67%, transparent); font-size: 14px; line-height: 1.6; }
  .article-meta,
  .card-topline { display: flex; flex-wrap: wrap; gap: 7px 13px; color: color-mix(in srgb, var(--color-text) 52%, transparent); font: 700 9px/1 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: .08em; text-transform: uppercase; }
  .featured-arrow { color: var(--color-accent); }
  .article-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 15px; }
  .experiment-card[hidden] { display: none; }
  :global(.article-card) { height: 100%; min-height: 295px; align-items: flex-start !important; justify-content: flex-start !important; text-align: left !important; }
  .card-topline { width: 100%; justify-content: space-between; }
  .card-format { color: var(--color-accent); }
  .card-icon { width: 43px; height: 43px; margin-top: 27px; border-radius: 12px; }
  .article-card h3 { margin: 15px 0 7px; color: var(--color-text); font-size: 19px; line-height: 1.15; letter-spacing: -.02em; }
  .article-card > p { margin: 0 0 20px; color: color-mix(in srgb, var(--color-text) 64%, transparent); font-size: 13px; line-height: 1.55; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
  .tag-list span { color: color-mix(in srgb, var(--color-text) 53%, transparent); font: 650 9px/1.2 ui-monospace, SFMono-Regular, Menlo, monospace; }
  .labs-footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 90px; padding-top: 20px; border-top: 1px solid var(--color-border); }
  .labs-footer a { display: inline-flex; align-items: center; gap: 7px; color: var(--color-text); font-size: 12px; font-weight: 700; text-decoration: none; }
  .labs-footer p { margin: 0; color: color-mix(in srgb, var(--color-text) 52%, transparent); font-size: 11px; }
  @media (max-width: 850px) { .article-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 620px) { .labs-shell { width: min(100% - 22px, 1180px); padding-top: 68px; } .featured-card { grid-template-columns: auto minmax(0, 1fr); } .featured-arrow { display: none; } .article-grid { grid-template-columns: 1fr; } .section-heading { align-items: flex-start; flex-direction: column; } .labs-footer { align-items: flex-start; flex-direction: column; } }
</style>
